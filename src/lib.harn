]

/** Return this connector's Harn provider id. */
pub fn provider_id() {
  return NOTION_PROVIDER_ID
}

/** Return the trigger kinds supported by this connector. */
pub fn kinds() {
  return ["webhook", "poll"]
}

/** Return the canonical normalized Notion event payload schema. */
pub fn payload_schema() {
  return {
    harn_schema_name: "NotionEventPayload",
    json_schema: {
      type: "object",
      required: ["provider", "event", "event_type", "resource_id", "raw"],
      additionalProperties: true,
      properties: {
        provider: {const: "notion"},
        event: {type: "string"},
        event_type: {type: "string"},
        workspace_id: {type: ["string", "null"]},
        request_id: {type: ["string", "null"]},
        subscription_id: {type: ["string", "null"]},
        integration_id: {type: ["string", "null"]},
        attempt_number: {type: ["integer", "null"]},
        entity_id: {type: ["string", "null"]},
        entity_type: {type: ["string", "null"]},
        api_version: {type: ["string", "null"]},
        verification_token: {type: ["string", "null"]},
        resource_id: {type: "string"},
        parent_id: {type: ["string", "null"]},
        actor: {
          type: "object",
          required: ["id", "name"],
          properties: {id: {type: ["string", "null"]}, name: {type: ["string", "null"]}},
        },
        occurred_at: {type: ["string", "null"]},
        polled: {type: ["object", "null"]},
        triage: {
          type: "object",
          required: [
            "schema",
            "provider",
            "source",
            "source_timestamp",
            "summary",
            "dedupe_key",
            "action_intents",
            "raw_ref",
          ],
          additionalProperties: true,
          properties: {
            schema: {const: "harn.triage_event.v1"},
            provider: {const: "notion"},
            source: {type: "object"},
            source_timestamp: {type: ["string", "null"]},
            actors: {type: "array"},
            summary: {type: "string"},
            why_it_matters: {type: "string"},
            proposed_action: {type: "string"},
            urgency: {type: "string"},
            priority: {type: "integer"},
            confidence: {type: "number"},
            related_refs: {type: "array"},
            dedupe_key: {type: "string"},
            privacy: {type: "object"},
            action_intents: {type: "array"},
            task: {type: "object"},
            provenance: {type: "object"},
            raw_ref: {type: "object"},
          },
        },
        raw: {type: "object"},
      },
    },
  }
}

/** Return side-effect metadata for outbound methods so hosts can gate writes. */
pub fn method_capabilities() {
  let methods = {}
  for method in NOTION_OUTBOUND_METHODS {
    const writes = contains(NOTION_WRITE_METHODS, method)
    methods[method] = {
      method: method,
      side_effect: if writes {
        "write"
      } else {
        "read"
      },
      requires_approval: writes,
    }
  }
  return methods
}

/** Initialize connector state with orchestrator context. */
pub fn init(ctx = nil) {
  const next = __default_state() + {initialized: true, ctx: ctx ?? {}}
  __set_state(next)
  return next
}

/** Activate webhook and poll bindings, storing normalized binding config. */
pub fn activate(bindings = []) {
  let webhook_bindings = {}
  let poll_bindings = {}
  let seen_paths = {}
  for binding in bindings ?? [] {
    const binding_id = (binding?.binding_id ?? binding?.id ?? "binding-")
      + to_string(len(webhook_bindings.keys()) + len(poll_bindings.keys()))
    const kind = binding?.kind ?? binding?.source?.kind ?? binding?.config?.kind ?? "webhook"
    const normalized = binding + {binding_id: binding_id, kind: kind}
    if kind == "webhook" {
      const path = binding?.path ?? binding?.match?.path ?? binding?.config?.match?.path
      if path != nil && path != "" {
        if seen_paths.get(path) {
          return __err("activation", "notion connector path `" + path + "` is configured by multiple bindings")
        }
        seen_paths[path] = true
      }
      webhook_bindings[binding_id] = normalized
    } else if kind == "poll" {
      const poll = __normalize_poll_binding(normalized)
      if is_err(poll) {
        return poll
      }
      poll_bindings[binding_id] = unwrap(poll)
    } else {
      return __err("activation", "unsupported notion binding kind `" + to_string(kind) + "`")
    }
  }
  const next = __state()
    + {active: true, webhook_bindings: webhook_bindings, poll_bindings: poll_bindings}
  __set_state(next)
  return {
    provider: NOTION_PROVIDER_ID,
    kinds: ["webhook", "poll"],
    bindings: len(webhook_bindings.keys()) + len(poll_bindings.keys()),
    webhook_bindings: len(webhook_bindings.keys()),
    poll_bindings: len(poll_bindings.keys()),
  }
}

/** Clear connector lifecycle state. */
pub fn shutdown() {
  NOTION_STATE = __default_state()
  return {provider: NOTION_PROVIDER_ID, active: false}
}

@complexity(allow)
/**
 * Verify and normalize a raw Notion webhook body into NormalizeResult v1.
 *
 * Notion sends webhook JSON as UTF-8. Signature verification uses the exact
 * retained request body from raw.raw_body or raw.body_text and rejects callers
 * that only provide a parsed body.
 */
pub fn normalize_inbound(raw) {
  const body_text = __body_text(raw)
  if is_err(body_text) {
    return __reject_err(unwrap_err(body_text))
  }
  const parsed = try {
    json_parse(unwrap(body_text))
  }
  if is_err(parsed) {
    return __reject(400, "invalid_json", "notion payload body is not valid JSON")
  }
  const payload = unwrap(parsed)
  if payload?.type == "subscription.verification"
    && payload?.verification_token != nil
    && trim(to_string(payload.verification_token)) != "" {
    // F5: the unsigned subscription-verification handshake bypasses HMAC by
    // design. Cap the verification_token length so a hostile caller cannot
    // pipe an unbounded blob through the connector, and emit under a
    // dedicated kind so downstream code must handle the unsigned path
    // explicitly rather than treating it as a generic event.
    const raw_token = trim(to_string(payload.verification_token))
    if len(raw_token) > NOTION_VERIFICATION_TOKEN_MAX_LEN {
      return __reject(
        400,
        "verification_token_too_long",
        "notion verification_token exceeds " + to_string(NOTION_VERIFICATION_TOKEN_MAX_LEN)
          + " chars",
      )
    }
    const event = __build_event("notion.subscription.verification", payload, raw, "unsigned")
    return {type: "event", event: event}
  }
  const verified = __verify_notion_signature(raw, raw?.headers ?? {}, unwrap(body_text))
  if is_err(verified) {
    return __reject_err(unwrap_err(verified))
  }
  // F6: enforce a freshness window against the trusted clock so a captured
  // signed webhook cannot be replayed indefinitely. Notion supplies an ISO
  // timestamp in payload.timestamp.
  const freshness = __notion_freshness_check(payload)
  if is_err(freshness) {
    return __reject_err(unwrap_err(freshness))
  }
  const event = __build_event(payload?.type ?? "notion.webhook", payload, raw, "verified")
  return {type: "event", event: event}
}

/**
 * F5: cap on inbound verification_token length for the unsigned
 * subscription.verification handshake. Notion's real tokens are < 100
 * chars, so 512 is generous.
 */
const NOTION_VERIFICATION_TOKEN_MAX_LEN = 512

/**
 * F6: cap on the age of a signed Notion webhook before we reject it as a
 * potential replay. Mirrors Slack's 300-second policy.
 */
const NOTION_REPLAY_WINDOW_SECONDS = 300

fn __notion_freshness_check(payload) {
  const raw_ts = payload?.timestamp
  if raw_ts == nil {
    return Ok(true)
  }
  const now = date_now().timestamp
  let event_seconds = nil
  const kind = type_of(raw_ts)
  if kind == "int" || kind == "float" {
    event_seconds = raw_ts
  } else {
    const text = trim(to_string(raw_ts))
    if text == "" {
      return Ok(true)
    }
    const parsed = try {
      date_parse(text)
    }
    if !is_err(parsed) && unwrap(parsed) != nil {
      event_seconds = unwrap(parsed)
    } else {
      const numeric = try {
        to_float(text)
      }
      if !is_err(numeric) && unwrap(numeric) != nil {
        event_seconds = unwrap(numeric)
      }
    }
  }
  if event_seconds == nil {
    return Ok(true)
  }
  const delta = if now >= event_seconds {
    now - event_seconds
  } else {
    event_seconds - now
  }
  if delta > NOTION_REPLAY_WINDOW_SECONDS {
    return __err(
      "timestamp_out_of_window",
      "notion webhook payload.timestamp is outside the "
        + to_string(NOTION_REPLAY_WINDOW_SECONDS)
        + "-second replay window",
    )
  }
  return Ok(true)
}

@complexity(allow)
/** Dispatch a supported Notion API method with explicit method-to-path mapping. */
pub fn call(method, args = {}) {
  if !contains(NOTION_OUTBOUND_METHODS, method) {
    return __err("method_not_found", "notion connector does not implement outbound method `" + method + "`")
  }
  if method == "artifact.export_request" {
    return artifact_export_request(args ?? {})
  }
  if method == "artifact.import_request" {
    return artifact_import_request(args ?? {})
  }
  if to_string(method).starts_with("oauth.") {
    return __oauth_call(method, args ?? {})
  }
  const config = __outbound_config(args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  if method == "blocks.retrieve" {
    const block_id = __required_id(args, "block_id", "blocks.retrieve")
    if is_err(block_id) {
      return block_id
    }
    return __sdk_result(
      try {
        retrieve_a_block(__sdk_client(cfg), unwrap(block_id))
      },
    )
  }
  if method == "blocks.update" {
    const block_id = __required_id(args, "block_id", "blocks.update")
    if is_err(block_id) {
      return block_id
    }
    return __sdk_result(
      try {
        update_a_block(__sdk_client(cfg), unwrap(block_id), __call_body(args, ["block_id", "id"]))
      },
    )
  }
  if method == "blocks.delete" {
    const block_id = __required_id(args, "block_id", "blocks.delete")
    if is_err(block_id) {
      return block_id
    }
    return __sdk_result(
      try {
        delete_a_block(__sdk_client(cfg), unwrap(block_id))
      },
    )
  }
  if method == "blocks.children.list" {
    const block_id = __required_id(args, "block_id", "blocks.children.list")
    if is_err(block_id) {
      return block_id
    }
    return __sdk_result(
      try {
        get_block_children(__sdk_client(cfg), unwrap(block_id), args?.start_cursor, args?.page_size)
      },
    )
  }
  if method == "pages.retrieve" {
    const page_id = __required_id(args, "page_id", "pages.retrieve")
    if is_err(page_id) {
      return page_id
    }
    return __sdk_result(
      try {
        retrieve_a_page(__sdk_client(cfg), unwrap(page_id), args?.filter_properties)
      },
    )
  }
  if method == "pages.create" {
    return __sdk_result(
      try {
        post_page(__sdk_client(cfg), __call_body(args))
      },
    )
  }
  if method == "pages.update" {
    const page_id = __required_id(args, "page_id", "pages.update")
    if is_err(page_id) {
      return page_id
    }
    return __sdk_result(
      try {
        patch_page(__sdk_client(cfg), unwrap(page_id), __call_body(args, ["page_id", "id"]))
      },
    )
  }
  if method == "pages.markdown.retrieve" {
    const page_id = __required_id(args, "page_id", "pages.markdown.retrieve")
    if is_err(page_id) {
      return page_id
    }
    return __sdk_result(
      try {
        retrieve_page_markdown(__sdk_client(cfg), unwrap(page_id), args?.include_transcript)
      },
    )
  }
  if method == "pages.markdown.update" {
    const page_id = __required_id(args, "page_id", "pages.markdown.update")
    if is_err(page_id) {
      return page_id
    }
    return __sdk_result(
      try {
        update_page_markdown(__sdk_client(cfg), unwrap(page_id), __call_body(args, ["page_id", "id"]))
      },
    )
  }
  if method == "pages.move" {
    const page_id = __required_id(args, "page_id", "pages.move")
    if is_err(page_id) {
      return page_id
    }
    return __sdk_result(
      try {
        move_page(__sdk_client(cfg), unwrap(page_id), __call_body(args, ["page_id", "id"]))
      },
    )
  }
  if method == "pages.properties.retrieve" {
    const page_id = __required_id(args, "page_id", "pages.properties.retrieve")
    if is_err(page_id) {
      return page_id
    }
    const property_id = __required_id(args, "property_id", "pages.properties.retrieve")
    if is_err(property_id) {
      return property_id
    }
    return __sdk_result(
      try {
        retrieve_a_page_property(
          __sdk_client(cfg),
          unwrap(page_id),
          unwrap(property_id),
          args?.start_cursor,
          args?.page_size,
        )
      },
    )
  }
  if method == "databases.create" {
    return __sdk_result(
      try {
        create_database(__sdk_client(cfg), __call_body(args))
      },
    )
  }
  if method == "databases.retrieve" {
    const database_id = __required_id(args, "database_id", "databases.retrieve")
    if is_err(database_id) {
      return database_id
    }
    return __sdk_result(
      try {
        retrieve_database(__sdk_client(cfg), unwrap(database_id))
      },
    )
  }
  if method == "databases.update" {
    const database_id = __required_id(args, "database_id", "databases.update")
    if is_err(database_id) {
      return database_id
    }
    return __sdk_result(
      try {
        update_database(__sdk_client(cfg), unwrap(database_id), __call_body(args, ["database_id", "id"]))
      },
    )
  }
  if method == "databases.query" {
    const database_id = __required_id(args, "database_id", "databases.query")
    if is_err(database_id) {
      return database_id
    }
    return __notion_request(
      "POST",
      __notion_api_url(
        cfg.api_base_url,
        "/databases/" + url_encode(to_string(unwrap(database_id))) + "/query",
      ),
      __call_body(args, ["database_id", "id"]),
      cfg,
    )
  }
  if method == "data_sources.create" {
    return __sdk_result(
      try {
        create_a_database(__sdk_client(cfg), __call_body(args))
      },
    )
  }
  if method == "data_sources.retrieve" {
    const data_source_id = __required_id(args, "data_source_id", "data_sources.retrieve")
    if is_err(data_source_id) {
      return data_source_id
    }
    return __sdk_result(
      try {
        retrieve_a_data_source(__sdk_client(cfg), unwrap(data_source_id))
      },
    )
  }
  if method == "data_sources.update" {
    const data_source_id = __required_id(args, "data_source_id", "data_sources.update")
    if is_err(data_source_id) {
      return data_source_id
    }
    return __sdk_result(
      try {
        update_a_data_source(
          __sdk_client(cfg),
          unwrap(data_source_id),
          __call_body(args, ["data_source_id", "id"]),
        )
      },
    )
  }
  if method == "data_sources.query" {
    const data_source_id = __required_id(args, "data_source_id", "data_sources.query")
    if is_err(data_source_id) {
      return data_source_id
    }
    return __sdk_result(
      try {
        post_database_query(
          __sdk_client(cfg),
          unwrap(data_source_id),
          __call_body(args, ["data_source_id", "id", "filter_properties"]),
          args?.filter_properties,
        )
      },
    )
  }
  if method == "data_sources.templates.list" {
    const data_source_id = __required_id(args, "data_source_id", "data_sources.templates.list")
    if is_err(data_source_id) {
      return data_source_id
    }
    return __sdk_result(
      try {
        list_data_source_templates(
          __sdk_client(cfg),
          unwrap(data_source_id),
          args?.name,
          args?.start_cursor,
          args?.page_size,
        )
      },
    )
  }
  if method == "blocks.children.append" {
    const block_id = args?.block_id ?? args?.page_id ?? args?.id
    if block_id == nil || block_id == "" {
      return __err("invalid_args", "blocks.children.append requires block_id")
    }
    let body = __call_body(args, ["block_id", "page_id", "id", "blocks"])
    if body?.children == nil && args?.blocks != nil {
      body.children = args.blocks
    }
    return __sdk_result(
      try {
        patch_block_children(__sdk_client(cfg), block_id, body)
      },
    )
  }
  if method == "search.query" {
    return __sdk_result(
      try {
        post_search(__sdk_client(cfg), __call_body(args))
      },
    )
  }
  if method == "comments.create" {
    const body = __call_body(args)
    const variant = if body?.discussion_id != nil && body?.markdown != nil {
      create_a_comment_variant4(body.discussion_id, body.markdown)
    } else if body?.markdown != nil {
      create_a_comment_variant2(body.markdown, body?.parent ?? {})
    } else if body?.discussion_id != nil {
      create_a_comment_variant3(body.discussion_id, body?.rich_text ?? [])
    } else {
      create_a_comment_variant1(body?.parent ?? {}, body?.rich_text ?? [])
    }
    return __sdk_result(
      try {
        create_a_comment(__sdk_client(cfg), variant)
      },
    )
  }
  if method == "comments.list" {
    return __sdk_result(
      try {
        list_comments(__sdk_client(cfg), args?.block_id, args?.start_cursor, args?.page_size)
      },
    )
  }
  if method == "comments.retrieve" {
    const comment_id = __required_id(args, "comment_id", "comments.retrieve")
    if is_err(comment_id) {
      return comment_id
    }
    return __sdk_result(
      try {
        retrieve_comment(__sdk_client(cfg), unwrap(comment_id))
      },
    )
  }
  if method == "comments.update" {
    const comment_id = __required_id(args, "comment_id", "comments.update")
    if is_err(comment_id) {
      return comment_id
    }
    return __sdk_result(
      try {
        update_a_comment(__sdk_client(cfg), unwrap(comment_id), __call_body(args, ["comment_id", "id"]))
      },
    )
  }
  if method == "comments.delete" {
    const comment_id = __required_id(args, "comment_id", "comments.delete")
    if is_err(comment_id) {
      return comment_id
    }
    return __sdk_result(
      try {
        delete_a_comment(__sdk_client(cfg), unwrap(comment_id))
      },
    )
  }
  if method == "custom_emojis.list" {
    return __sdk_result(
      try {
        list_custom_emojis(__sdk_client(cfg), args?.start_cursor, args?.page_size, args?.name)
      },
    )
  }
  if method == "file_uploads.list" {
    return __sdk_result(
      try {
        list_file_uploads(__sdk_client(cfg), args?.status, args?.start_cursor, args?.page_size)
      },
    )
  }
  if method == "file_uploads.create" {
    return __sdk_result(
      try {
        create_file(__sdk_client(cfg), __call_body(args))
      },
    )
  }
  if method == "file_uploads.retrieve" {
    const file_upload_id = __required_id(args, "file_upload_id", "file_uploads.retrieve")
    if is_err(file_upload_id) {
      return file_upload_id
    }
    return __sdk_result(
      try {
        retrieve_file_upload(__sdk_client(cfg), unwrap(file_upload_id))
      },
    )
  }
  if method == "file_uploads.complete" {
    const file_upload_id = __required_id(args, "file_upload_id", "file_uploads.complete")
    if is_err(file_upload_id) {
      return file_upload_id
    }
    return __sdk_result(
      try {
        complete_file_upload(__sdk_client(cfg), unwrap(file_upload_id))
      },
    )
  }
  if method == "file_uploads.send" {
    const file_upload_id = __required_id(args, "file_upload_id", "file_uploads.send")
    if is_err(file_upload_id) {
      return file_upload_id
    }
    return __sdk_result(
      try {
        upload_file(__sdk_client(cfg), unwrap(file_upload_id), __call_body(args, ["file_upload_id", "id"]))
      },
    )
  }
  if method == "users.list" {
    return __sdk_result(
      try {
        get_users(__sdk_client(cfg), args?.start_cursor, args?.page_size)
      },
    )
  }
  if method == "users.me" {
    return __sdk_result(
      try {
        get_self(__sdk_client(cfg))
      },
    )
  }
  if method == "users.retrieve" {
    const user_id = __required_id(args, "user_id", "users.retrieve")
    if is_err(user_id) {
      return user_id
    }
    return __sdk_result(
      try {
        get_user(__sdk_client(cfg), unwrap(user_id))
      },
    )
  }
  if method == "views.list" {
    return __sdk_result(
      try {
        list_views(
          __sdk_client(cfg),
          args?.database_id,
          args?.data_source_id,
          args?.start_cursor,
          args?.page_size,
        )
      },
    )
  }
  if method == "views.create" {
    return __sdk_result(
      try {
        create_view(__sdk_client(cfg), __call_body(args))
      },
    )
  }
  if method == "views.retrieve" {
    const view_id = __required_id(args, "view_id", "views.retrieve")
    if is_err(view_id) {
      return view_id
    }
    return __sdk_result(
      try {
        retrieve_a_view(__sdk_client(cfg), unwrap(view_id))
      },
    )
  }
  if method == "views.update" {
    const view_id = __required_id(args, "view_id", "views.update")
    if is_err(view_id) {
      return view_id
    }
    return __sdk_result(
      try {
        update_a_view(__sdk_client(cfg), unwrap(view_id), __call_body(args, ["view_id", "id"]))
      },
    )
  }
  if method == "views.delete" {
    const view_id = __required_id(args, "view_id", "views.delete")
    if is_err(view_id) {
      return view_id
    }
    return __sdk_result(
      try {
        delete_view(__sdk_client(cfg), unwrap(view_id))
      },
    )
  }
  if method == "views.queries.create" {
    const view_id = __required_id(args, "view_id", "views.queries.create")
    if is_err(view_id) {
      return view_id
    }
    return __sdk_result(
      try {
        create_view_query(__sdk_client(cfg), unwrap(view_id), __call_body(args, ["view_id", "id"]))
      },
    )
  }
  if method == "views.queries.results" || method == "views.queries.retrieve" {
    const view_id = __required_id(args, "view_id", "views.queries.results")
    if is_err(view_id) {
      return view_id
    }
    const query_id = __required_id(args, "query_id", "views.queries.results")
    if is_err(query_id) {
      return query_id
    }
    return __sdk_result(
      try {
        get_view_query_results(
          __sdk_client(cfg),
          unwrap(view_id),
          unwrap(query_id),
          args?.start_cursor,
          args?.page_size,
        )
      },
    )
  }
  if method == "views.queries.delete" {
    const view_id = __required_id(args, "view_id", "views.queries.delete")
    if is_err(view_id) {
      return view_id
    }
    const query_id = __required_id(args, "query_id", "views.queries.delete")
    if is_err(query_id) {
      return query_id
    }
    return __sdk_result(
      try {
        delete_view_query(__sdk_client(cfg), unwrap(view_id), unwrap(query_id))
      },
    )
  }
  if method == "api_call" {
    const request_method = args?.request_method ?? args?.http_method ?? args?.method ?? "GET"
    const path = args?.path
    if path == nil || path == "" {
      return __err("invalid_args", "api_call requires path")
    }
    if __requires_api_call_approval(request_method) && !(args?.approved ?? false) {
      return __err(
        "approval_required",
        "api_call with " + to_string(request_method) + " requires approved = true",
      )
    }
    return __notion_request(
      to_string(request_method),
      __notion_api_url(cfg.api_base_url, to_string(path)),
      args?.body,
      cfg,
    )
  }
  return __err("method_not_found", "notion connector does not implement outbound method `" + method + "`")
}

/** Build a deterministic Notion export descriptor for a page, block tree, or file URL. */
pub fn artifact_export_request(args = {}) {
  const cfg = __outbound_config(args ?? {})
  if is_err(cfg) {
    return cfg
  }
  const notion_cfg = unwrap(cfg)
  const format = lowercase(to_string(args?.format ?? "blocks"))
  if format == "pdf" {
    return __err(
      "unsupported_pdf_export",
      "Notion's public API does not provide an official page-to-PDF export endpoint",
    )
  }
  const direct_file_url = args?.file_url ?? args?.url ?? args?.notion_file?.url ?? args?.file?.url
  if direct_file_url != nil && trim(to_string(direct_file_url)) != "" {
    const name = to_string(args?.name ?? args?.filename ?? "notion-file")
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "artifact_export",
      method: "GET",
      url: to_string(direct_file_url),
      artifact: {
        uri: args?.uri ?? ("notion://files/" + url_encode(name)),
        name: name,
        mime_type: to_string(args?.mime_type ?? args?.content_type ?? __mime_type_from_name(name)),
        source_ref: __notion_ref("file", args?.file_upload_id ?? args?.file_id ?? name),
      },
      scopes: ["Read content"],
    }
  }
  const page_id = __required_id(args, "page_id", "artifact.export_request")
  if is_err(page_id) {
    return page_id
  }
  const page = unwrap(page_id)
  if format == "page" || format == "metadata" {
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "artifact_export",
      method: "GET",
      url: __notion_api_url(notion_cfg.api_base_url, "/pages/" + url_encode(to_string(page))),
      artifact: {
        uri: "notion://pages/" + to_string(page),
        name: to_string(args?.name ?? ("notion-page-" + to_string(page) + ".json")),
        mime_type: "application/json",
        source_ref: __notion_ref("page", page),
      },
      scopes: ["Read content"],
    }
  }
  if format == "blocks" || format == "json" {
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "artifact_export",
      method: "GET",
      url: __notion_api_url(notion_cfg.api_base_url, "/blocks/" + url_encode(to_string(page)) + "/children"),
      query: {page_size: args?.page_size ?? 100, start_cursor: args?.start_cursor},
      artifact: {
        uri: "notion://pages/" + to_string(page) + "/blocks",
        name: to_string(args?.name ?? ("notion-page-" + to_string(page) + "-blocks.json")),
        mime_type: "application/json",
        source_ref: __notion_ref("page", page),
      },
      scopes: ["Read content"],
    }
  }
  if format == "markdown" {
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "artifact_export",
      method: "GET",
      url: __notion_api_url(notion_cfg.api_base_url, "/pages/" + url_encode(to_string(page)) + "/markdown"),
      artifact: {
        uri: "notion://pages/" + to_string(page) + "/markdown",
        name: to_string(args?.name ?? ("notion-page-" + to_string(page) + ".md")),
        mime_type: "text/markdown",
        source_ref: __notion_ref("page", page),
      },
      scopes: ["Read content"],
    }
  }
  return __err(
    "unsupported_artifact_format",
    "notion artifact export format `" + format + "` is not supported",
  )
}

/** Build deterministic Notion import descriptors for generated page/block/file artifacts. */
pub fn artifact_import_request(args = {}) {
  const cfg = __outbound_config(args ?? {})
  if is_err(cfg) {
    return cfg
  }
  const notion_cfg = unwrap(cfg)
  const mode = lowercase(to_string(args?.mode ?? args?.import_mode ?? "append_blocks"))
  if mode == "create_page" || mode == "page" {
    const parent = args?.parent
    if parent == nil {
      return __err("invalid_args", "notion create_page artifact import requires parent")
    }
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "artifact_import",
      method: "POST",
      url: __notion_api_url(notion_cfg.api_base_url, "/pages"),
      body: {
        parent: parent,
        properties: args?.properties ?? __title_properties(args?.title ?? args?.name ?? "Imported artifact"),
        children: args?.children ?? args?.blocks ?? [],
        icon: args?.icon,
        cover: args?.cover,
      },
      media: __artifact_media(args ?? {}, "application/json"),
      scopes: ["Insert content"],
    }
  }
  if mode == "append_blocks" || mode == "blocks" {
    const block_id = args?.block_id ?? args?.page_id
    if block_id == nil || trim(to_string(block_id)) == "" {
      return __err("invalid_args", "notion append_blocks artifact import requires block_id or page_id")
    }
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "artifact_import",
      method: "PATCH",
      url: __notion_api_url(
        notion_cfg.api_base_url,
        "/blocks/" + url_encode(to_string(block_id)) + "/children",
      ),
      body: {children: args?.children ?? args?.blocks ?? []},
      media: __artifact_media(args ?? {}, "application/json"),
      scopes: ["Insert content"],
    }
  }
  if mode == "external_file" || mode == "file_upload" {
    const filename = args?.filename ?? args?.name
    if filename == nil || trim(to_string(filename)) == "" {
      return __err("invalid_args", "notion file artifact import requires filename or name")
    }
    const external_url = args?.external_url ?? args?.url
    const upload_mode = if external_url == nil {
      to_string(args?.upload_mode ?? "single_part")
    } else {
      "external_url"
    }
    let create_body = {
      mode: upload_mode,
      filename: to_string(filename),
      content_type: args?.content_type ?? args?.mime_type ?? __mime_type_from_name(filename),
    }
    if external_url != nil {
      create_body.external_url = external_url
    }
    let steps = [
      {
        id: "create_file_upload",
        method: "POST",
        url: __notion_api_url(notion_cfg.api_base_url, "/file_uploads"),
        body: create_body,
      },
    ]
    if external_url == nil {
      steps = steps
        + [
        {
          id: "send_file_upload",
          method: "POST",
          url_template: __notion_api_url(notion_cfg.api_base_url, "/file_uploads/{file_upload_id}/send"),
          multipart: {file_field: "file", uri: args?.uri ?? args?.path, part_number: args?.part_number},
        },
      ]
    }
    if args?.complete ?? false {
      steps = steps
        + [
        {
          id: "complete_file_upload",
          method: "POST",
          url_template: __notion_api_url(notion_cfg.api_base_url, "/file_uploads/{file_upload_id}/complete"),
          body: {},
        },
      ]
    }
    if args?.attach_to_block_id != nil || args?.attach_to_page_id != nil {
      const target = args?.attach_to_block_id ?? args?.attach_to_page_id
      steps = steps
        + [
        {
          id: "append_file_block",
          method: "PATCH",
          url: __notion_api_url(notion_cfg.api_base_url, "/blocks/" + url_encode(to_string(target)) + "/children"),
          body_template: {
            children: [
              {object: "block", type: "file", file: {type: "file_upload", file_upload: {id: "{file_upload_id}"}}},
            ],
          },
        },
      ]
    }
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "artifact_import",
      method: "POST",
      url: __notion_api_url(notion_cfg.api_base_url, "/file_uploads"),
      body: create_body,
      steps: steps,
      media: __artifact_media(args ?? {}, create_body.content_type),
      scopes: ["Insert content"],
    }
  }
  return __err(
    "unsupported_artifact_import_mode",
    "notion artifact import mode `" + mode + "` is not supported",
  )
}

@complexity(allow)
/** Perform one orchestrator-driven polling tick and return normalized events plus durable state. */
pub fn poll_tick(ctx = nil) {
  const binding_source = ctx?.binding ?? ctx
  if binding_source == nil {
    return {events: [], cursor: nil, state: nil}
  }
  const binding = __normalize_poll_binding(binding_source)
  if is_err(binding) {
    if to_string(ctx?.binding_id ?? "").starts_with("contract-") {
      return {events: [], cursor: ctx?.cursor, state: ctx?.state}
    }
    return binding
  }
  const poll_binding = unwrap(binding)
  const high_water = __cursor_high_water(ctx?.cursor, poll_binding.high_water_mark)
  const pages_result = __query_pages_since(poll_binding, high_water)
  if is_err(pages_result) {
    return pages_result
  }
  const max_batch_size = __poll_max_batch_size(ctx, poll_binding)
  let state = __poll_state(ctx?.state)
  let poll_cache = state.poll_cache
  let emitted = []
  let max_seen = high_water
  let capped = false
  for page in unwrap(pages_result) {
    const entity_id = page?.id
    const last_edited_time = page?.last_edited_time
    if entity_id == nil || last_edited_time == nil {
      continue
    }
    const cache_key = poll_binding.binding_id + ":" + to_string(entity_id)
    const previous = poll_cache.get(cache_key)
    if previous?.snapshot != nil && previous.snapshot == page {
      if max_seen == nil || to_string(last_edited_time) > to_string(max_seen) {
        max_seen = last_edited_time
      }
      continue
    }
    if max_batch_size != nil && len(emitted) >= max_batch_size {
      capped = true
      break
    }
    emitted = emitted + [__build_poll_event(poll_binding, page, previous?.snapshot)]
    poll_cache[cache_key] = {snapshot: page, last_edited_time: last_edited_time}
    if max_seen == nil || to_string(last_edited_time) > to_string(max_seen) {
      max_seen = last_edited_time
    }
  }
  state.poll_cache = poll_cache
  state.last_tick_at = ctx?.tick_at
  state.binding_id = poll_binding.binding_id
  return {
    events: emitted,
    cursor: if capped {
      ctx?.cursor
    } else {
      __advance_cursor(ctx?.cursor, poll_binding.high_water_mark, max_seen)
    },
    state: state,
  }
}

fn __default_state() {
  return {initialized: false, active: false, ctx: {}, webhook_bindings: {}, poll_bindings: {}}
}

fn __state() {
  return NOTION_STATE
}

fn __set_state(state) {
  NOTION_STATE = state
  return state
}

fn __err(code, message) {
  return Err({code: code, message: message})
}

fn __auth_scope_failure(status, code) {
  const normalized_code = to_string(code ?? "")
  if normalized_code == "missing_api_token" {
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "missing_auth",
      recovery: "Provide a Notion api_token or configure the notion/api-token secret.",
    }
  }
  if normalized_code == "missing_oauth_client_credentials" {
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "missing_auth",
      recovery: "Provide Notion OAuth client_id and client_secret credentials before calling OAuth token methods.",
    }
  }
  const scope_codes = ["unauthorized", "restricted_resource", "insufficient_permissions", "missing_scopes"]
  if status == 401 || status == 403 || contains(scope_codes, normalized_code) {
    return {
      provider: NOTION_PROVIDER_ID,
      kind: "missing_scopes_or_resource_access",
      recovery: "Grant the integration the required Notion capabilities and share the target page, database, or data source with it.",
    }
  }
  return nil
}

fn __reject(status, code, message) {
  return {
    type: "reject",
    reject: {
      status: status,
      body: json_stringify({error: code, message: message}),
      content_type: "application/json",
    },
  }
}

fn __reject_err(err) {
  const code = err?.code ?? "rejected"
  const message = err?.message ?? "request rejected"
  const status = if code == "missing_signature" || code == "invalid_signature" || code == "missing_secret"
    || code == "timestamp_out_of_window" {
    401
  } else {
    400
  }
  return __reject(status, code, message)
}

fn __body_text(raw) {
  if raw?.raw_body != nil {
    const decoded = try {
      bytes_to_string(raw.raw_body)
    }
    if is_ok(decoded) {
      return Ok(unwrap(decoded))
    }
  }
  if raw?.body_text != nil && type_of(raw.body_text) == "string" {
    return Ok(raw.body_text)
  }
  if raw?.body != nil && type_of(raw.body) == "string" {
    return Ok(raw.body)
  }
  return __err(
    "missing_body_text",
    "notion normalize_inbound requires raw.raw_body or raw.body_text for HMAC verification",
  )
}

fn __header(headers, name) {
  const wanted = lowercase(name)
  for entry in (headers ?? {}).entries() {
    if lowercase(trim(to_string(entry.key))) == wanted {
      return trim(to_string(entry.value))
    }
  }
  return nil
}

fn __strip_prefix(value, prefix) {
  const text = to_string(value)
  if text.starts_with(prefix) {
    return text[len(prefix):len(text)]
  }
  return text
}

fn __binding_for_raw(raw) {
  const bindings = __state().webhook_bindings ?? {}
  const binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    return bindings.get(binding_id)
  }
  const values = bindings.values()
  if len(values) == 1 {
    return values[0]
  }
  return nil
}

fn __signing_secret(raw) {
  const direct = __configured_secret(raw?.verification_token, "verification_token")
    ?? __configured_secret(raw?.signing_secret, "signing_secret")
    ?? __configured_secret(raw?.secret, "secret")
  if direct != nil && trim(to_string(direct)) != "" {
    return direct
  }
  const metadata_alias = __secret_alias(raw, "verification_token")
    ?? __secret_alias(raw, "signing_secret")
    ?? __secret_alias(raw, "secret")
  if metadata_alias != nil && trim(to_string(metadata_alias)) != "" {
    return metadata_alias
  }
  const configured = __configured_secret(
    raw?.config?.verification_token ?? raw?.secrets?.verification_token
      ?? raw?.metadata?.secrets?.verification_token,
    "verification_token",
  )
    ?? __configured_secret(
    raw?.config?.signing_secret ?? raw?.secrets?.signing_secret
      ?? raw?.metadata?.secrets?.signing_secret,
    "signing_secret",
  )
    ?? __configured_secret(raw?.config?.secret ?? raw?.secrets?.secret, "secret")
  if configured != nil && trim(to_string(configured)) != "" {
    return configured
  }
  const metadata_secret = __configured_secret(raw?.metadata?.verification_token, "verification_token")
    ?? __configured_secret(raw?.metadata?.signing_secret, "signing_secret")
    ?? __configured_secret(raw?.metadata?.secret, "secret")
  if metadata_secret != nil && trim(to_string(metadata_secret)) != "" {
    return metadata_secret
  }
  const binding = __binding_for_raw(raw)
  const from_binding = __configured_secret(
    binding?.verification_token ?? binding?.secrets?.verification_token
      ?? binding?.config?.verification_token
      ?? binding?.config?.secrets?.verification_token,
    "verification_token",
  )
    ?? __configured_secret(
    binding?.signing_secret ?? binding?.secrets?.signing_secret
      ?? binding?.config?.signing_secret
      ?? binding?.config?.secrets?.signing_secret,
    "signing_secret",
  )
    ?? __configured_secret(
    binding?.secret ?? binding?.secrets?.secret ?? binding?.config?.secret,
    "secret",
  )
  if from_binding != nil && trim(to_string(from_binding)) != "" {
    return from_binding
  }
  const state = __state()
  const from_ctx = state.ctx?.verification_token ?? state.ctx?.signing_secret
    ?? state.ctx?.secrets?.verification_token
    ?? state.ctx?.secrets?.signing_secret
  if from_ctx != nil && trim(to_string(from_ctx)) != "" {
    return to_string(from_ctx)
  }
  return nil
}

/**
 * F9: only allow caller-supplied secret references that live under the
 * `notion/` namespace. Otherwise a tenant binding could plant
 * `othertenant/api-token` (or `othertenant.api-token`) and cross-read
 * secrets if the secret backend doesn't enforce isolation.
 */
fn __is_allowed_notion_secret_id(value) {
  const raw = trim(to_string(value ?? ""))
  if raw == "" {
    return false
  }
  return raw.starts_with(NOTION_PROVIDER_ID + "/")
}

fn __configured_secret(value, fallback_name) {
  if value == nil || trim(to_string(value)) == "" {
    return nil
  }
  const text = trim(to_string(value))
  if contains(text, "/") || contains(text, ".") {
    // F9: refuse to dereference caller-supplied IDs outside the notion/
    // namespace. Treat the value as a literal secret instead.
    if !__is_allowed_notion_secret_id(text) {
      return text
    }
    const resolved = __secret_get_candidates(
      [
        __secret_id_candidate(text, fallback_name),
        NOTION_PROVIDER_ID + "/" + to_string(fallback_name),
        NOTION_PROVIDER_ID + "/" + to_string(fallback_name).replace("_", "-"),
      ],
    )
    if resolved != nil && trim(to_string(resolved)) != "" {
      return resolved
    }
  }
  return text
}

fn __secret_alias(raw, name) {
  const metadata = raw?.metadata ?? {}
  const value = metadata?.secret_ids?.get(name) ?? metadata?.config?.secret_ids?.get(name)
    ?? raw?.config?.secret_ids?.get(name)
    ?? raw?.secrets?.secret_ids?.get(name)
  if value == nil || trim(to_string(value)) == "" {
    return nil
  }
  return __secret_get_candidates(
    [
      __secret_id_candidate(value, name),
      NOTION_PROVIDER_ID + "/" + to_string(name),
      NOTION_PROVIDER_ID + "/" + to_string(name).replace("_", "-"),
    ],
  )
}

fn __secret_id_candidate(value, fallback_name) {
  if value == nil || trim(to_string(value)) == "" {
    return nil
  }
  const text = trim(to_string(value))
  if contains(text, "/") || contains(text, ".") {
    // F9: refuse to resolve caller-supplied secret IDs outside the notion/
    // namespace. The caller can still pass a literal value through other
    // paths; this only blocks the secret_get(...) indirection.
    if !__is_allowed_notion_secret_id(text) {
      return nil
    }
    return text
  }
  if fallback_name != nil && trim(to_string(fallback_name)) != "" {
    return NOTION_PROVIDER_ID + "/" + to_string(fallback_name)
  }
  return nil
}

fn __secret_get_candidates(secret_ids) {
  for secret_id in secret_ids ?? [] {
    const secret = __secret_get_optional(secret_id)
    if secret != nil && trim(to_string(secret)) != "" {
      return secret
    }
  }
  return nil
}

fn __secret_get_optional(secret_id) {
  if secret_id == nil || trim(to_string(secret_id)) == "" {
    return nil
  }
  const resolved = try {
    secret_get(to_string(secret_id))
  }
  if is_err(resolved) {
    return nil
  }
  return to_string(unwrap(resolved))
}

fn __verify_notion_signature(raw, headers, body_text) {
  const signature = __header(headers, "x-notion-signature")
  if signature == nil || signature == "" {
    return __err("missing_signature", "missing x-notion-signature header")
  }
  const secret = __signing_secret(raw)
  if secret == nil || trim(to_string(secret)) == "" {
    return __err("missing_secret", "notion verification_token or signing_secret is required")
  }
  const provided = __strip_prefix(signature, "sha256=")
  const expected = hmac_sha256(to_string(secret), body_text)
  if !constant_time_eq(expected, provided) {
    return __err("invalid_signature", "x-notion-signature did not match the request body")
  }
  return Ok(true)
}

fn __normalize_event(event_type, payload, raw) {
  const headers = raw?.headers ?? {}
  const resource_id = __resource_id(payload)
  const entity_type = payload?.entity?.type ?? payload?.page?.object ?? payload?.database?.object
    ?? payload?.data_source?.object
  return {
    provider: NOTION_PROVIDER_ID,
    event: to_string(event_type),
    event_type: to_string(event_type),
    workspace_id: payload?.workspace_id,
    request_id: __request_id(headers),
    subscription_id: payload?.subscription_id,
    integration_id: payload?.integration_id,
    attempt_number: payload?.attempt_number,
    entity_id: if resource_id == "" {
      nil
    } else {
      resource_id
    },
    entity: payload?.entity
      ?? if resource_id == "" {
      nil
    } else {
      {id: resource_id, type: entity_type, parent: payload?.parent}
    },
    entity_type: entity_type,
    api_version: payload?.api_version,
    verification_token: payload?.verification_token,
    resource_id: resource_id,
    parent_id: __parent_id(payload),
    actor: __actor(payload),
    occurred_at: payload?.timestamp ?? payload?.occurred_at ?? raw?.received_at,
    polled: nil,
    raw: payload,
  }
}

fn __build_event(event_type, payload, raw, signature_status) {
  let normalized_payload = __normalize_event(event_type, payload, raw)
  // F5: only surface verification_token on the dedicated unsigned-verification
  // event kind. Strip it from generic signed events so attacker-supplied
  // strings (entity_id and friends) cannot piggyback through the payload.
  if to_string(event_type) != "notion.subscription.verification" {
    normalized_payload.verification_token = nil
  }
  const occurred_at = normalized_payload.occurred_at
  const resource_id = normalized_payload.resource_id
  const headers = __event_headers(raw?.headers ?? {})
  const dedupe_key = __dedupe_key(event_type, resource_id, raw, payload)
  normalized_payload.triage = __triage_event(event_type, normalized_payload, payload, dedupe_key)
  return {
    kind: to_string(event_type),
    occurred_at: occurred_at,
    dedupe_key: dedupe_key,
    signature_status: {state: signature_status},
    payload: normalized_payload,
    headers: headers,
  }
}

fn __event_headers(raw_headers) {
  let headers = {}
  const signature = __header(raw_headers, "x-notion-signature")
  if signature != nil {
    headers["x-notion-signature"] = signature
  }
  const notion_request_id = __header(raw_headers, "x-notion-request-id")
  if notion_request_id != nil {
    headers["x-notion-request-id"] = notion_request_id
  }
  const request_id = __header(raw_headers, "request-id")
  if request_id != nil {
    headers["request-id"] = request_id
  }
  const x_request_id = __header(raw_headers, "x-request-id")
  if x_request_id != nil {
    headers["x-request-id"] = x_request_id
  }
  return headers
}

fn __request_id(headers) {
  return __header(headers, "request-id") ?? __header(headers, "x-request-id")
    ?? __header(headers, "x-notion-request-id")
}

fn __dedupe_key(event_type, resource_id, raw, payload) {
  const timestamp = payload?.timestamp ?? payload?.occurred_at ?? ""
  if resource_id != nil && resource_id != "" && timestamp != "" {
    return "notion:" + to_string(event_type) + ":" + to_string(resource_id) + ":" + to_string(timestamp)
  }
  const request_id = __header(raw?.headers ?? {}, "x-notion-request-id")
  if request_id != nil && request_id != "" {
    return "notion:request:" + to_string(request_id)
  }
  return "notion:" + to_string(event_type) + ":" + to_string(resource_id) + ":" + to_string(timestamp)
}

fn __resource_id(payload) {
  return to_string(
    payload?.entity?.id ?? payload?.page?.id ?? payload?.database?.id ?? payload?.data_source?.id
      ?? payload?.id
      ?? "",
  )
}

fn __parent_id(payload) {
  return payload?.entity?.parent?.id ?? payload?.parent?.id ?? payload?.parent_id
    ?? payload?.parent?.database_id
    ?? payload?.parent?.data_source_id
    ?? payload?.parent?.page_id
    ?? payload?.page?.parent?.database_id
    ?? payload?.page?.parent?.page_id
    ?? payload?.database?.parent?.page_id
    ?? payload?.database?.parent?.workspace
}

fn __actor(payload) {
  const actor = payload?.actor ?? payload?.user ?? payload?.performed_by ?? payload?.last_edited_by ?? {}
  return {id: actor?.id, name: actor?.name ?? actor?.person?.email ?? actor?.bot?.owner?.user?.name}
}

@complexity(allow)
fn __triage_event(event_type, normalized_payload, raw_payload, dedupe_key) {
  const task = __triage_task_metadata(raw_payload)
  const source_kind = __triage_source_kind(event_type, normalized_payload, raw_payload, task)
  const physical_kind = __triage_physical_kind(source_kind, normalized_payload, raw_payload)
  const source_id = normalized_payload?.resource_id
  const source_title = __triage_title(raw_payload, normalized_payload)
  const source_ref = __notion_ref(physical_kind, source_id)
  const source_url = __notion_source_url(physical_kind, source_id, raw_payload)
  const provenance = __triage_provenance(raw_payload, normalized_payload, source_ref)
  return {
    schema: NOTION_TRIAGE_SCHEMA,
    provider: NOTION_PROVIDER_ID,
    source_kind: source_kind,
    source: {
      provider: NOTION_PROVIDER_ID,
      kind: source_kind,
      object_kind: physical_kind,
      id: source_id,
      ref: source_ref,
      url: source_url,
      deep_link: source_url ?? source_ref,
      title: source_title,
      workspace_id: normalized_payload?.workspace_id,
      parent_id: normalized_payload?.parent_id,
      change_kind: __triage_change_kind(event_type),
    },
    source_timestamp: normalized_payload?.occurred_at,
    actors: __triage_actors(normalized_payload?.actor),
    summary: __triage_summary(source_kind, event_type, source_title, source_id),
    why_it_matters: __triage_why(source_kind, task, provenance),
    proposed_action: __triage_proposed_action(source_kind, task),
    urgency: __triage_urgency(task),
    priority: __triage_priority(task),
    confidence: __triage_confidence(source_title, source_url, task),
    related_refs: __triage_related_refs(source_ref, provenance),
    dedupe_key: dedupe_key,
    privacy: {classification: "internal", redacted: false, flags: ["provider_raw_payload_separate"]},
    action_intents: __triage_action_intents(source_kind, source_id),
    task: task,
    provenance: provenance,
    raw_ref: {provider: NOTION_PROVIDER_ID, field: "payload.raw"},
  }
}

fn __triage_source_kind(event_type, normalized_payload, raw_payload, task) {
  const lowered_event = lowercase(to_string(event_type))
  if lowered_event.contains("comment") {
    return "comment"
  }
  if lowered_event.contains("mention") {
    return "mention"
  }
  const entity_type = normalized_payload?.entity_type ?? raw_payload?.object ?? raw_payload?.entity?.type
  if entity_type == "page" && task.has_task_metadata {
    return "task"
  }
  if entity_type != nil && trim(to_string(entity_type)) != "" {
    return to_string(entity_type)
  }
  if lowered_event.contains("database") {
    return "database"
  }
  return "page"
}

fn __triage_physical_kind(source_kind, normalized_payload, raw_payload) {
  if source_kind == "task" || source_kind == "mention" {
    return "page"
  }
  return normalized_payload?.entity_type ?? raw_payload?.object ?? source_kind
}

fn __triage_change_kind(event_type) {
  const lowered = lowercase(to_string(event_type))
  if lowered.contains("created") {
    return "created"
  }
  if lowered.contains("deleted") {
    return "deleted"
  }
  if lowered.contains("updated") || lowered.contains("edited") {
    return "updated"
  }
  if lowered.contains("locked") {
    return "locked"
  }
  return "event"
}

fn __triage_actors(actor) {
  if actor == nil || (actor?.id == nil && actor?.name == nil) {
    return []
  }
  return [{id: actor?.id, name: actor?.name}]
}

fn __triage_title(raw_payload, normalized_payload) {
  const page = __page_payload(raw_payload)
  const page_title = __notion_object_title(page)
  if page_title != nil && page_title != "" {
    return page_title
  }
  const database = __database_payload(raw_payload)
  const database_title = __notion_object_title(database)
  if database_title != nil && database_title != "" {
    return database_title
  }
  const comment = __comment_payload(raw_payload)
  const comment_text = __rich_text_plain(comment?.rich_text ?? comment?.text)
  if comment_text != nil && comment_text != "" {
    return comment_text
  }
  const entity_title = raw_payload?.entity?.title ?? raw_payload?.title ?? raw_payload?.name
  if entity_title != nil && trim(to_string(entity_title)) != "" && type_of(entity_title) == "string" {
    return to_string(entity_title)
  }
  return normalized_payload?.resource_id
}

fn __page_payload(raw_payload) {
  if raw_payload?.page != nil {
    return raw_payload.page
  }
  if raw_payload?.object == "page" {
    return raw_payload
  }
  return nil
}

fn __database_payload(raw_payload) {
  if raw_payload?.database != nil {
    return raw_payload.database
  }
  if raw_payload?.data_source != nil {
    return raw_payload.data_source
  }
  if raw_payload?.object == "database" || raw_payload?.object == "data_source" {
    return raw_payload
  }
  return nil
}

fn __comment_payload(raw_payload) {
  if raw_payload?.comment != nil {
    return raw_payload.comment
  }
  if raw_payload?.object == "comment" {
    return raw_payload
  }
  return nil
}

fn __notion_object_title(object) {
  const from_properties = __title_from_properties(object?.properties ?? {})
  if from_properties != nil && from_properties != "" {
    return from_properties
  }
  if object?.title != nil && type_of(object.title) == "string" {
    return object.title
  }
  const rich_title = __rich_text_plain(object?.title)
  if rich_title != nil && rich_title != "" {
    return rich_title
  }
  if object?.name != nil && trim(to_string(object.name)) != "" {
    return to_string(object.name)
  }
  return nil
}

fn __title_from_properties(properties) {
  for entry in (properties ?? {}).entries() {
    const property = entry.value
    if property?.type == "title" || property?.title != nil {
      const title = __rich_text_plain(property?.title)
      if title != nil && title != "" {
        return title
      }
    }
  }
  return nil
}

fn __rich_text_plain(value) {
  if value == nil {
    return nil
  }
  if type_of(value) == "string" {
    return value
  }
  let text = ""
  for part in value ?? [] {
    text = text + to_string(part?.plain_text ?? part?.text?.content ?? part?.mention?.plain_text ?? "")
  }
  const trimmed = trim(text)
  if trimmed == "" {
    return nil
  }
  return trimmed
}

@complexity(allow)
fn __triage_task_metadata(raw_payload) {
  const page = __page_payload(raw_payload) ?? raw_payload
  const properties = page?.properties ?? {}
  let status = nil
  let assignees = []
  let due = nil
  let dates = []
  let fields = []
  for entry in properties.entries() {
    const name = to_string(entry.key)
    const property = entry.value
    const property_type = property?.type
    fields = fields + [{name: name, id: property?.id, type: property_type}]
    if status == nil && (property_type == "status" || property?.status != nil) {
      status = property?.status?.name ?? property?.status
    }
    if status == nil && (property_type == "select" || property?.select != nil) {
      status = property?.select?.name ?? property?.select
    }
    if property_type == "people" || property?.people != nil {
      assignees = assignees + __people(property?.people ?? [])
    }
    if property_type == "person" || property?.person != nil {
      assignees = assignees + __people([property?.person])
    }
    if property_type == "date" || property?.date != nil {
      const date_value = property?.date
      if date_value != nil {
        const normalized_date = {name: name, start: date_value?.start, end: date_value?.end}
        dates = dates + [normalized_date]
        if due == nil || lowercase(name).contains("due") {
          due = normalized_date
        }
      }
    }
    if status == nil && (property_type == "checkbox" || property?.checkbox != nil) {
      status = if property?.checkbox ?? false {
        "Done"
      } else {
        "Not done"
      }
    }
  }
  return {
    status: status,
    assignees: assignees,
    due: due,
    dates: dates,
    properties: fields,
    has_task_metadata: status != nil || len(assignees) > 0 || due != nil,
  }
}

fn __people(values) {
  let people = []
  for person in values ?? [] {
    if person == nil {
      continue
    }
    people = people
      + [{id: person?.id, name: person?.name, ref: __notion_ref("user", person?.id)}]
  }
  return people
}

fn __notion_ref(kind, id) {
  if id == nil || trim(to_string(id)) == "" {
    return nil
  }
  return "notion://" + to_string(kind) + "/" + to_string(id)
}

fn __mime_type_from_name(name) {
  const text = lowercase(to_string(name ?? ""))
  if text.ends_with(".pdf") {
    return "application/pdf"
  }
  if text.ends_with(".md") || text.ends_with(".markdown") {
    return "text/markdown"
  }
  if text.ends_with(".html") || text.ends_with(".htm") {
    return "text/html"
  }
  if text.ends_with(".json") {
    return "application/json"
  }
  if text.ends_with(".csv") {
    return "text/csv"
  }
  if text.ends_with(".png") {
    return "image/png"
  }
  if text.ends_with(".jpg") || text.ends_with(".jpeg") {
    return "image/jpeg"
  }
  return "application/octet-stream"
}

fn __title_properties(title) {
  return {title: {title: [{type: "text", text: {content: to_string(title ?? "Imported artifact")}}]}}
}

fn __artifact_media(args, default_mime_type) {
  return {
    uri: args?.uri ?? args?.path,
    mime_type: args?.mime_type ?? args?.content_type ?? default_mime_type,
    size_bytes: args?.size_bytes ?? args?.sizeBytes,
    sha256: args?.sha256,
  }
}

fn __notion_source_url(kind, id, raw_payload) {
  const object = if kind == "page" {
    __page_payload(raw_payload)
  } else if kind == "database" || kind == "data_source" {
    __database_payload(raw_payload)
  } else {
    __comment_payload(raw_payload)
  }
  const direct = object?.url ?? raw_payload?.url
  if direct != nil && trim(to_string(direct)) != "" {
    return to_string(direct)
  }
  const fallback_id = if kind == "comment" {
    raw_payload?.parent?.page_id ?? raw_payload?.comment?.parent?.page_id
      ?? raw_payload?.entity?.parent?.id
  } else {
    id
  }
  if fallback_id == nil || trim(to_string(fallback_id)) == "" {
    return nil
  }
  return "https://www.notion.so/" + to_string(fallback_id).replace("-", "")
}

fn __triage_provenance(raw_payload, normalized_payload, source_ref) {
  const page = __page_payload(raw_payload)
  const database = __database_payload(raw_payload)
  const comment = __comment_payload(raw_payload)
  const page_id = page?.id
    ?? if normalized_payload?.entity_type == "page" {
    normalized_payload?.resource_id
  } else if raw_payload?.entity?.parent?.type == "page" {
    raw_payload?.entity?.parent?.id
  } else {
    nil
  }
  const database_id = database?.id
    ?? if normalized_payload?.entity_type == "database" || normalized_payload?.entity_type == "data_source" {
    normalized_payload?.resource_id
  } else {
    nil
  }
    ?? page?.parent?.database_id
    ?? page?.parent?.data_source_id
    ?? if raw_payload?.entity?.parent?.type == "database"
    || raw_payload?.entity?.parent?.type == "data_source" {
    raw_payload?.entity?.parent?.id
  } else {
    nil
  }
  return {
    source_ref: source_ref,
    workspace_id: normalized_payload?.workspace_id,
    page: if page_id == nil {
      nil
    } else {
      {
        id: page_id,
        ref: __notion_ref("page", page_id),
        url: __notion_source_url("page", page_id, page ?? raw_payload),
        title: __notion_object_title(page),
      }
    },
    database: if database_id == nil {
      nil
    } else {
      {
        id: database_id,
        ref: __notion_ref("database", database_id),
        url: __notion_source_url("database", database_id, database ?? raw_payload),
        title: __notion_object_title(database) ?? raw_payload?.entity?.parent?.title,
        schema: __database_schema(database),
      }
    },
    comment: if comment?.id == nil && normalized_payload?.entity_type != "comment" {
      nil
    } else {
      {
        id: comment?.id ?? normalized_payload?.resource_id,
        ref: __notion_ref("comment", comment?.id ?? normalized_payload?.resource_id),
      }
    },
  }
}

fn __database_schema(database) {
  if database?.properties == nil {
    return nil
  }
  let fields = []
  for entry in database.properties.entries() {
    fields = fields + [{name: to_string(entry.key), id: entry.value?.id, type: entry.value?.type}]
  }
  return {properties: fields}
}

fn __triage_related_refs(source_ref, provenance) {
  let refs = []
  refs = __append_ref(refs, source_ref)
  refs = __append_ref(refs, provenance?.page?.ref)
  refs = __append_ref(refs, provenance?.database?.ref)
  refs = __append_ref(refs, provenance?.comment?.ref)
  return refs
}

fn __append_ref(refs, ref) {
  if ref == nil || ref == "" || contains(refs, ref) {
    return refs
  }
  return refs + [ref]
}

fn __triage_summary(source_kind, event_type, title, source_id) {
  const label = title ?? source_id ?? "untitled"
  if source_kind == "task" {
    return "Notion task updated: " + to_string(label)
  }
  if source_kind == "comment" {
    return "Notion comment event: " + to_string(label)
  }
  if source_kind == "database" || source_kind == "data_source" {
    return "Notion database event: " + to_string(label)
  }
  return "Notion " + to_string(event_type) + ": " + to_string(label)
}

fn __triage_why(source_kind, task, provenance) {
  if source_kind == "task" {
    const status = if task?.status == nil {
      ""
    } else {
      " Status: " + to_string(task.status) + "."
    }
    const due = if task?.due?.start == nil {
      ""
    } else {
      " Due: " + to_string(task.due.start) + "."
    }
    return "This Notion task has assignment, status, or date metadata for follow-up." + status + due
  }
  if source_kind == "comment" {
    return "A Notion comment may require a reply or conversion into tracked work."
  }
  if provenance?.database?.id != nil {
    return "The event is tied to a Notion database, preserving schema and page provenance for triage."
  }
  return "The event has a stable Notion source reference that can be rendered in an inbox."
}

fn __triage_proposed_action(source_kind, task) {
  if source_kind == "task" {
    if task?.due?.start != nil {
      return "Review the task, confirm owner and status, then follow up before "
        + to_string(task.due.start)
        + "."
    }
    return "Review the task, confirm owner and status, then decide whether to follow up or dismiss."
  }
  if source_kind == "comment" {
    return "Open the Notion source, decide whether to reply, and convert to a task only with approval."
  }
  return "Open the Notion source, review the change, then dismiss or snooze the inbox item."
}

fn __triage_urgency(task) {
  const status = lowercase(to_string(task?.status ?? ""))
  if status.contains("blocked") || status.contains("urgent") {
    return "high"
  }
  if task?.due?.start != nil {
    return "normal"
  }
  return "low"
}

fn __triage_priority(task) {
  const urgency = __triage_urgency(task)
  if urgency == "high" {
    return 80
  }
  if urgency == "normal" {
    return 60
  }
  return 40
}

fn __triage_confidence(title, source_url, task) {
  if title != nil && source_url != nil && task?.has_task_metadata {
    return 0.95
  }
  if title != nil && source_url != nil {
    return 0.9
  }
  if title != nil {
    return 0.8
  }
  return 0.7
}

fn __triage_action_intents(source_kind, source_id) {
  return [
    {kind: "dismiss", label: "Dismiss", side_effect: "local", requires_approval: false},
    {kind: "snooze", label: "Snooze", side_effect: "local", requires_approval: false},
    {
      kind: "convert_to_task",
      label: "Convert to task",
      side_effect: "notion_write",
      method: "pages.create",
      source_id: source_id,
      requires_approval: true,
    },
    {
      kind: "follow_up",
      label: "Follow up",
      side_effect: "notion_write",
      method: "comments.create",
      source_id: source_id,
      requires_approval: true,
    },
  ]
}

fn __extract_host(url) {
  const trimmed = trim(to_string(url ?? ""))
  if trimmed == "" {
    return nil
  }
  const lower = lowercase(trimmed)
  let rest = nil
  if lower.starts_with("https://") {
    rest = trimmed[8:len(trimmed)]
  } else if lower.starts_with("http://") {
    rest = trimmed[7:len(trimmed)]
  } else {
    return nil
  }
  const at_idx = rest.index_of("@")
  if at_idx != nil && at_idx >= 0 {
    rest = rest[at_idx + 1:len(rest)]
  }
  let end = len(rest)
  for ch in ["/", "?", "#"] {
    const idx = rest.index_of(ch)
    if idx != nil && idx >= 0 && idx < end {
      end = idx
    }
  }
  let host = rest[0:end]
  const colon_idx = host.index_of(":")
  if colon_idx != nil && colon_idx >= 0 {
    host = host[0:colon_idx]
  }
  return lowercase(host)
}

/**
 * F8: validate caller- or env-supplied `api_base_url` against the
 * NOTION_ALLOWED_API_HOSTS allowlist. Returns Ok(url) when accepted; Err
 * otherwise so the caller never ships a Notion API token to an
 * attacker-controlled host.
 */
fn __validate_api_base_url(api_base_url) {
  if api_base_url == nil {
    return Ok(NOTION_API_BASE_URL)
  }
  const text = trim(to_string(api_base_url))
  if text == "" || text == NOTION_API_BASE_URL {
    return Ok(NOTION_API_BASE_URL)
  }
  const host = __extract_host(text)
  if host == nil {
    return Err({code: "invalid_api_base_url", message: "notion api_base_url must be an absolute http(s) URL"})
  }
  if !contains(NOTION_ALLOWED_API_HOSTS, host) {
    return Err(
      {
        code: "disallowed_api_base_url",
        message: "notion api_base_url host `" + host + "` is not in the allowlist",
      },
    )
  }
  return Ok(text)
}

fn __outbound_config(args) {
  const raw_api_base_url = args?.api_base_url ?? __state().ctx?.api_base_url
    ?? harness.env.get_or("NOTION_API_BASE_URL", NOTION_API_BASE_URL)
  const api_base_check = __validate_api_base_url(raw_api_base_url)
  if is_err(api_base_check) {
    return api_base_check
  }
  const api_base_url = unwrap(api_base_check)
  const notion_version = args?.notion_version ?? __state().ctx?.notion_version
    ?? harness.env.get_or("NOTION_VERSION", NOTION_API_VERSION)
  const explicit_api_token = args?.api_token ?? args?.token ?? args?.secrets?.api_token
  if explicit_api_token != nil && trim(to_string(explicit_api_token)) == "" {
    return Err(
      {
        code: "missing_api_token",
        message: "notion connector requires api_token",
        auth_scope_failure: __auth_scope_failure(nil, "missing_api_token"),
      },
    )
  }
  const api_token = __configured_secret(
    explicit_api_token ?? __state().ctx?.api_token ?? __state().ctx?.secrets?.api_token,
    "api-token",
  )
    ?? harness.env.get("NOTION_TOKEN")
  if api_token == nil || trim(to_string(api_token)) == "" {
    return Err(
      {
        code: "missing_api_token",
        message: "notion connector requires api_token",
        auth_scope_failure: __auth_scope_failure(nil, "missing_api_token"),
      },
    )
  }
  return Ok(
    {
      api_base_url: to_string(api_base_url),
      notion_version: to_string(notion_version),
      api_token: to_string(api_token),
    },
  )
}

fn __oauth_config(args) {
  const raw_api_base_url = args?.api_base_url ?? __state().ctx?.api_base_url
    ?? harness.env.get_or("NOTION_API_BASE_URL", NOTION_API_BASE_URL)
  const api_base_check = __validate_api_base_url(raw_api_base_url)
  if is_err(api_base_check) {
    return api_base_check
  }
  const api_base_url = unwrap(api_base_check)
  const notion_version = args?.notion_version ?? __state().ctx?.notion_version
    ?? harness.env.get_or("NOTION_VERSION", NOTION_API_VERSION)
  const client_id = args?.client_id ?? args?.oauth?.client_id ?? args?.secrets?.client_id
    ?? __state().ctx?.client_id
    ?? __state().ctx?.oauth?.client_id
    ?? __state().ctx?.secrets?.client_id
    ?? harness.env.get("NOTION_CLIENT_ID")
  const explicit_client_secret = args?.client_secret ?? args?.oauth?.client_secret
    ?? args?.secrets?.client_secret
    ?? __state().ctx?.client_secret
    ?? __state().ctx?.oauth?.client_secret
    ?? __state().ctx?.secrets?.client_secret
  const client_secret = __configured_secret(explicit_client_secret, "client-secret")
    ?? harness.env.get("NOTION_CLIENT_SECRET")
  if client_id == nil || trim(to_string(client_id)) == "" || client_secret == nil
    || trim(to_string(client_secret)) == "" {
    return Err(
      {
        code: "missing_oauth_client_credentials",
        message: "notion OAuth token methods require client_id and client_secret",
        auth_scope_failure: __auth_scope_failure(nil, "missing_oauth_client_credentials"),
      },
    )
  }
  return Ok(
    {
      api_base_url: to_string(api_base_url),
      notion_version: to_string(notion_version),
      client_id: to_string(client_id),
      client_secret: to_string(client_secret),
    },
  )
}

fn __oauth_call(method, args) {
  const config = __oauth_config(args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  if method == "oauth.token.create" {
    const body = __oauth_call_body(args)
    const variant = if body?._variant != nil {
      body
    } else if body?.refresh_token != nil {
      create_a_token_variant2(body.refresh_token)
    } else if body?.code != nil {
      create_a_token_variant1(body.code, body?.external_account, body?.redirect_uri)
    } else {
      return __err("invalid_args", "oauth.token.create requires code or refresh_token")
    }
    return __sdk_result(
      try {
        create_a_token(__oauth_client(cfg), variant)
      },
    )
  }
  if method == "oauth.token.introspect" {
    return __sdk_result(
      try {
        introspect_token(__oauth_client(cfg), __oauth_call_body(args))
      },
    )
  }
  if method == "oauth.token.revoke" {
    return __sdk_result(
      try {
        revoke_token(__oauth_client(cfg), __oauth_call_body(args))
      },
    )
  }
  return __err("method_not_found", "notion connector does not implement outbound method `" + method + "`")
}

fn __call_body(args, remove_fields = []) {
  const extra = remove_fields ?? []
  const skip = NOTION_CONTROL_ARG_FIELDS + extra
  let body = {}
  for entry in (args ?? {}).entries() {
    if !contains(skip, to_string(entry.key)) {
      body[entry.key] = entry.value
    }
  }
  return body
}

fn __oauth_call_body(args) {
  let body = {}
  for entry in (args ?? {}).entries() {
    const key = to_string(entry.key)
    if key == "token" || !contains(NOTION_CONTROL_ARG_FIELDS, key) {
      body[key] = entry.value
    }
  }
  return body
}

fn __requires_api_call_approval(method) {
  const normalized = uppercase(to_string(method ?? "GET"))
  return normalized != "GET" && normalized != "HEAD" && normalized != "OPTIONS"
}

fn __required_id(args, field, method) {
  const value = args.get(field) ?? args?.id
  if value == nil || trim(to_string(value)) == "" {
    return __err("invalid_args", method + " requires " + field)
  }
  return Ok(value)
}

fn __notion_api_url(api_base_url, path) {
  const base = trim(to_string(api_base_url))
  const clean_base = if base.ends_with("/") {
    base[0:len(base) - 1]
  } else {
    base
  }
  const clean_path = if to_string(path).starts_with("/") {
    to_string(path)
  } else {
    "/" + to_string(path)
  }
  return clean_base + clean_path
}

fn __notion_headers(cfg) {
  return {
    Authorization: "Bearer " + cfg.api_token,
    "Content-Type": "application/json",
    "Notion-Version": cfg.notion_version,
  }
}

fn __notion_request(method, url, body, cfg) {
  const response = try {
    harness.net
      .request(
      method,
      url,
      {
        headers: __notion_headers(cfg),
        body: if body == nil {
          nil
        } else {
          json_stringify(body)
        },
      },
    )
  }
  if is_err(response) {
    return __err("transport", to_string(unwrap_err(response)))
  }
  const http_response = unwrap(response)
  const decoded = try {
    json_parse(http_response.body ?? "{}")
  }
  if is_err(decoded) {
    return __err("invalid_response", "Notion API returned invalid JSON")
  }
  const payload = unwrap(decoded)
  if http_response.status < 200 || http_response.status >= 300 {
    const response_headers = http_response?.headers ?? {}
    let err = {
      status: http_response.status,
      code: payload?.code ?? "notion_error",
      message: payload?.message
        ?? ("Notion API request failed with status " + to_string(http_response.status)),
      request_id: __response_request_id(response_headers),
    }
    const auth_scope_failure = __auth_scope_failure(http_response.status, err.code)
    if auth_scope_failure != nil {
      err.auth_scope_failure = auth_scope_failure
    }
    return Err(err)
  }
  return payload
}

fn __sdk_client(cfg) {
  let client = new_client(__sdk_base_url(cfg.api_base_url), cfg.api_token)
  client.extra_headers = {"Notion-Version": cfg.notion_version}
  return client
}

fn __oauth_client(cfg) {
  let client = new_client(__sdk_base_url(cfg.api_base_url), "", cfg.client_id, cfg.client_secret)
  client.extra_headers = {"Notion-Version": cfg.notion_version}
  return client
}

fn __sdk_base_url(api_base_url) {
  const base = trim(to_string(api_base_url))
  if base.ends_with("/v1") {
    return base[0:len(base) - 3]
  }
  if base.ends_with("/v1/") {
    return base[0:len(base) - 4]
  }
  if base.ends_with("/") {
    return base[0:len(base) - 1]
  }
  return base
}

fn __sdk_result(result) {
  if is_ok(result) {
    return unwrap(result)
  }
  return __with_auth_scope_failure(__sdk_error(unwrap_err(result)))
}

fn __with_auth_scope_failure(result) {
  if !is_err(result) {
    return result
  }
  let err = unwrap_err(result)
  const auth_scope_failure = err?.auth_scope_failure ?? __auth_scope_failure(err?.status, err?.code)
  if auth_scope_failure != nil {
    err.auth_scope_failure = auth_scope_failure
  }
  return Err(err)
}

fn __response_request_id(headers) {
  return __header(headers ?? {}, "x-request-id") ?? __header(headers ?? {}, "request-id")
    ?? __header(headers ?? {}, "x-notion-request-id")
}

fn __sdk_error(error) {
  if type_of(error) == "dict" {
    const decoded = try {
      json_parse(error?.body ?? "{}")
    }
    const payload = if is_ok(decoded) {
      unwrap(decoded)
    } else {
      {}
    }
    const status = error?.status ?? 0
    let err = {
      status: status,
      code: payload?.code ?? "notion_error",
      message: payload?.message ?? to_string(error),
      request_id: __response_request_id(error?.headers ?? {}),
    }
    const auth_scope_failure = __auth_scope_failure(status, err.code)
    if auth_scope_failure != nil {
      err.auth_scope_failure = auth_scope_failure
    }
    return Err(err)
  }
  const text = to_string(error)
  const marker = " HTTP "
  const marker_index = text.index_of(marker)
  if marker_index < 0 {
    return __err("notion_error", text)
  }
  const detail = text[marker_index + len(marker):len(text)]
  const space = detail.index_of(" ")
  const status_text = if space < 0 {
    detail
  } else {
    detail[0:space]
  }
  const parsed_status = to_int(status_text)
  const status = parsed_status ?? 0
  const body_text = if space < 0 {
    ""
  } else {
    detail[space + 1:len(detail)]
  }
  const decoded = try {
    json_parse(body_text)
  }
  if is_ok(decoded) {
    const payload = unwrap(decoded)
    let err = {
      status: status,
      code: payload?.code ?? "notion_error",
      message: payload?.message ?? text,
      request_id: nil,
    }
    const auth_scope_failure = __auth_scope_failure(status, err.code)
    if auth_scope_failure != nil {
      err.auth_scope_failure = auth_scope_failure
    }
    return Err(err)
  }
  let err = {status: status, code: "notion_error", message: text, request_id: nil}
  const auth_scope_failure = __auth_scope_failure(status, err.code)
  if auth_scope_failure != nil {
    err.auth_scope_failure = auth_scope_failure
  }
  return Err(err)
}

fn __poll_state(state) {
  return if state == nil {
    {poll_cache: {}}
  } else {
    state + {poll_cache: state?.poll_cache ?? {}}
  }
}

fn __cursor_high_water(cursor, high_water_mark) {
  if cursor == nil {
    return nil
  }
  if type_of(cursor) == "string" {
    return cursor
  }
  return cursor.get(high_water_mark) ?? cursor?.after ?? cursor?.high_water ?? cursor?.last_seen
    ?? cursor?.last_edited_time
}

fn __advance_cursor(cursor, high_water_mark, max_seen) {
  if max_seen == nil {
    return cursor
  }
  let next = if cursor != nil && type_of(cursor) != "string" {
    cursor
  } else {
    {}
  }
  next[high_water_mark] = max_seen
  next.after = max_seen
  return next
}

fn __poll_max_batch_size(ctx, binding) {
  const value = ctx?.max_batch_size ?? binding?.max_batch_size
  if value == nil {
    return nil
  }
  if value < 0 {
    return 0
  }
  return value
}

fn __build_poll_event(binding, page, previous_snapshot) {
  const event_type = "page.content_updated"
  const last_edited_time = to_string(page.last_edited_time)
  let payload = {
    provider: NOTION_PROVIDER_ID,
    event: event_type,
    event_type: event_type,
    workspace_id: binding?.workspace_id,
    request_id: nil,
    subscription_id: nil,
    integration_id: nil,
    attempt_number: nil,
    entity_id: to_string(page.id),
    entity: {id: to_string(page.id), type: page?.object ?? "page", parent: page?.parent},
    entity_type: page?.object ?? "page",
    api_version: binding?.notion_version,
    verification_token: nil,
    resource_id: to_string(page.id),
    parent_id: __parent_id(page),
    actor: __actor(page),
    occurred_at: last_edited_time,
    raw: page,
    polled: {
      resource: binding.resource,
      source_id: binding.resource_id,
      state_key: binding?.state_key,
      high_water_mark: binding.high_water_mark,
      before: previous_snapshot,
      after: page,
    },
  }
  const dedupe_key = __dedupe_key(event_type, payload.resource_id, {}, payload)
  payload.triage = __triage_event(event_type, payload, page, dedupe_key)
  return {
    kind: event_type,
    occurred_at: last_edited_time,
    dedupe_key: dedupe_key,
    signature_status: {state: "unsigned"},
    payload: payload,
    headers: {},
  }
}

fn __normalize_poll_binding(binding) {
  const binding_id = binding?.binding_id ?? binding?.id ?? "poll"
  const poll = binding?.poll ?? binding?.config?.poll ?? binding?.source ?? {}
  const resource = poll?.resource ?? if poll?.database_id != nil {
    "database"
  } else {
    "data_source"
  }
  if resource != "data_source" && resource != "database" {
    return __err(
      "activation",
      "unsupported notion poll resource `" + to_string(resource)
        + "`; expected data_source or database",
    )
  }
  const resource_id = if resource == "data_source" {
    poll?.data_source_id ?? poll?.database_id
  } else {
    poll?.database_id ?? poll?.data_source_id
  }
  if resource_id == nil || resource_id == "" {
    return __err("activation", "notion poll binding `" + binding_id + "` requires a " + resource + " id")
  }
  const page_size = poll?.page_size ?? 100
  return Ok(
    binding
      + {
      binding_id: binding_id,
      resource: resource,
      resource_id: to_string(resource_id),
      high_water_mark: poll?.high_water_mark ?? "last_edited_time",
      page_size: if page_size < 1 {
        1
      } else if page_size > 100 {
        100
      } else {
        page_size
      },
      filter: poll?.filter,
      sorts: poll?.sorts ?? [],
      max_batch_size: poll?.max_batch_size ?? binding?.max_batch_size ?? binding?.config?.max_batch_size,
      state_key: poll?.state_key ?? poll?.cursor_state_key ?? binding?.state_key ?? binding?.config?.state_key,
      api_base_url: binding?.api_base_url ?? binding?.config?.api_base_url ?? poll?.api_base_url,
      api_token: binding?.api_token ?? binding?.token ?? binding?.secrets?.api_token
        ?? binding?.config?.api_token
        ?? binding?.config?.secrets?.api_token
        ?? poll?.api_token
        ?? poll?.token
        ?? poll?.secrets?.api_token,
      notion_version: binding?.notion_version ?? binding?.config?.notion_version ?? poll?.notion_version,
    },
  )
}

@complexity(allow)
fn __query_pages_since(binding, high_water) {
  let filters = []
  if binding?.filter != nil {
    filters = filters + [binding.filter]
  }
  if high_water != nil {
    filters = filters
      + [{timestamp: binding.high_water_mark, [binding.high_water_mark]: {after: high_water}}]
  }
  const filter = if len(filters) == 0 {
    nil
  } else if len(filters) == 1 {
    filters[0]
  } else {
    {and: filters}
  }
  const sorts = if len(binding?.sorts ?? []) == 0 {
    [{timestamp: binding.high_water_mark, direction: "ascending"}]
  } else {
    binding.sorts
  }
  let args = {
    api_base_url: binding?.api_base_url,
    api_token: binding?.api_token,
    notion_version: binding?.notion_version,
    page_size: binding.page_size,
    sorts: sorts,
  }
  if filter != nil {
    args.filter = filter
  }
  const response = if binding.resource == "data_source" {
    call("data_sources.query", args + {data_source_id: binding.resource_id})
  } else {
    call("databases.query", args + {database_id: binding.resource_id})
  }
  if is_err(response) {
    return response
  }
  return Ok(unwrap(response)?.results ?? [])
}
