const NOTION_TRIAGE_SCHEMA = "harn.triage_event.v1"

const NOTION_CONTROL_ARG_FIELDS = [
  "api_base_url",
  "api_token",
  "token",
  "api_token_secret",
  "notion_version",
  "secrets",
