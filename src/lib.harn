const NOTION_PROVIDER_ID = "notion"

let NOTION_STATE = {initialized: false, active: false, ctx: {}, webhook_bindings: {}, poll_bindings: {}}

const NOTION_API_BASE_URL = "https://api.notion.com/v1"

const NOTION_API_VERSION = "2026-03-11"

/**
 * F8: hosts permitted for outbound Notion API calls. Caller-supplied
 * `api_base_url` overrides are validated against this allowlist before
 * any HTTP request so the workspace API token cannot be shipped to
 * attacker-controlled hosts.
 */
const NOTION_ALLOWED_API_HOSTS = ["api.notion.com"]

const NOTION_OUTBOUND_METHODS = [
  "blocks.retrieve",
  "blocks.update",
  "blocks.delete",
  "blocks.children.list",
  "pages.retrieve",
