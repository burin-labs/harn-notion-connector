import { artifact_export_request, artifact_import_request, call, init, shutdown } from "../src/lib"
import { expect, expect_eq } from "./assertions"

pipeline default() {
  egress_policy({allow: ["api.notion.com"], default: "deny"})
  shutdown()
  init(
    {api_token: "secret_api", api_base_url: "https://api.notion.com/v1", notion_version: "2026-03-11"},
  )
  http_mock_clear()
  let base = "https://api.notion.com/v1"
  http_mock(
    "*",
    base + "/*",
    {
      responses: [
        {
          status: 200,
          body: "{\"object\":\"page\",\"id\":\"page_123\"}",
          headers: {"x-request-id": "req_page"},
        },
        {
          status: 200,
          body: "{\"object\":\"list\",\"results\":[{\"id\":\"page_a\"}],\"has_more\":false}",
          headers: {},
        },
        {status: 200, body: "{\"object\":\"page\",\"id\":\"page_new\"}", headers: {}},
        {status: 200, body: "{\"object\":\"block\",\"id\":\"block_1\"}", headers: {}},
        {status: 200, body: "{\"object\":\"list\",\"results\":[],\"has_more\":false}", headers: {}},
        {status: 200, body: "{\"object\":\"comment\",\"id\":\"comment_1\"}", headers: {}},
      ],
    },
  )
  let page = call("pages.retrieve", {page_id: "page_123"})
  expect_eq(page.id, "page_123", "pages.retrieve response")
  let query = call("databases.query", {database_id: "db_123", page_size: 10})
  expect_eq(query.object, "list", "databases.query response")
  call("pages.create", {parent: {database_id: "db_123"}, properties: {Name: {title: []}}})
  call("blocks.children.append", {block_id: "page_123", children: []})
  call(
    "search.query",
    {query: "task", page_size: 25, start_cursor: "cursor_a", api_token: "secret_api"},
  )
  call("comments.create", {discussion_id: "discussion_123", markdown: "Follow up"})
  let calls = http_mock_calls()
  expect_eq(len(calls), 6, "all expected outbound methods dispatched")
  expect_eq(calls[0].method, "GET", "retrieve uses GET")
  expect_eq(calls[0].url, base + "/pages/page_123", "retrieve URL")
  expect_eq(calls[0].headers.get("authorization"), "[redacted]", "authorization header is redacted")
  expect_eq(calls[0].headers.get("notion-version"), "2026-03-11", "notion version header")
  expect_eq(calls[1].method, "POST", "query uses POST")
  expect_eq(calls[1].url, base + "/databases/db_123/query", "database query URL")
  let query_body = json_parse(calls[1].body)
  expect_eq(query_body.get("page_size"), 10, "query body page size")
  expect_eq(query_body.get("database_id"), nil, "query path id is not leaked into body")
  expect_eq(query_body.get("api_token"), nil, "query auth token is not leaked into body")
  expect_eq(calls[3].url, base + "/blocks/page_123/children", "append children URL")
  let append_body = json_parse(calls[3].body)
  expect_eq(append_body.get("block_id"), nil, "append path id is not leaked into body")
  let search_body = json_parse(calls[4].body)
  expect_eq(search_body.get("page_size"), 25, "search body keeps pagination page size")
  expect_eq(search_body.get("start_cursor"), "cursor_a", "search body keeps pagination cursor")
  expect_eq(search_body.get("api_token"), nil, "search auth token is not leaked into body")
  let comment_body = json_parse(calls[5].body)
  expect_eq(
    comment_body.get("discussion_id"),
    "discussion_123",
    "discussion markdown comment uses discussion id",
  )
  expect_eq(comment_body.get("markdown"), "Follow up", "discussion markdown comment keeps markdown")
  expect_eq(
    comment_body.get("parent"),
    nil,
    "discussion markdown comment does not synthesize an empty parent",
  )
  http_mock_clear()
  http_mock(
    "GET",
    base + "/pages/missing",
    {
      status: 404,
      body: "{\"object\":\"error\",\"code\":\"object_not_found\",\"message\":\"missing page\"}",
      headers: {"x-request-id": "req_404"},
    },
  )
  let missing = call("pages.retrieve", {page_id: "missing"})
  expect(is_err(missing), "non-2xx response becomes Err")
  expect_eq(unwrap_err(missing).code, "object_not_found", "NotionError code")
  expect_eq(unwrap_err(missing).status, 404, "NotionError status")
  expect_eq(unwrap_err(missing).request_id, "req_404", "NotionError request id")
  let unsupported = call("workspaces.retrieve", {workspace_id: "workspace_1"})
  expect(is_err(unsupported), "unsupported method rejected")
  expect_eq(unwrap_err(unsupported).code, "method_not_found", "unsupported method code")
  let unapproved_api_call = call("api_call", {request_method: "POST", path: "/pages", body: {parent: {page_id: "page_123"}}})
  expect(is_err(unapproved_api_call), "write-like api_call requires approval")
  expect_eq(unwrap_err(unapproved_api_call).code, "approval_required", "api_call approval code")
  let page_export = artifact_export_request({page_id: "page_123", format: "page", name: "report.json"})
  expect_eq(page_export.kind, "artifact_export", "page export descriptor kind")
  expect_eq(page_export.method, "GET", "page export method")
  expect_eq(page_export.url, base + "/pages/page_123", "page export URL")
  expect_eq(page_export.artifact.mime_type, "application/json", "page export mime")
  let block_export = call("artifact.export_request", {page_id: "page_123", format: "blocks", page_size: 25})
  expect_eq(block_export.url, base + "/blocks/page_123/children", "block export URL")
  expect_eq(block_export.query.page_size, 25, "block export page size")
  let file_export = artifact_export_request(
    {file_url: "https://secure.notion-static.com/report.pdf", name: "report.pdf"},
  )
  expect_eq(file_export.url, "https://secure.notion-static.com/report.pdf", "file URL export")
  expect_eq(file_export.artifact.mime_type, "application/pdf", "file MIME inferred")
  let pdf_export = artifact_export_request({page_id: "page_123", format: "pdf"})
  expect(is_err(pdf_export), "Notion page PDF export is unsupported")
  expect_eq(unwrap_err(pdf_export).code, "unsupported_pdf_export", "Notion PDF export code")
  let create_import = artifact_import_request(
    {
      mode: "create_page",
      parent: {page_id: "parent_123"},
      title: "Generated report",
      children: [{object: "block", type: "paragraph", paragraph: {rich_text: []}}],
      uri: "artifact://session/report.json",
    },
  )
  expect_eq(create_import.kind, "artifact_import", "create import kind")
  expect_eq(create_import.method, "POST", "create import method")
  expect_eq(create_import.url, base + "/pages", "create import URL")
  expect_eq(
    create_import.body.properties.title.title[0].text.content,
    "Generated report",
    "default title",
  )
  expect_eq(create_import.media.uri, "artifact://session/report.json", "create import media URI")
  let append_import = call(
    "artifact.import_request",
    {
      mode: "append_blocks",
      page_id: "page_123",
      blocks: [{object: "block", type: "divider", divider: {}}],
    },
  )
  expect_eq(append_import.method, "PATCH", "append import method")
  expect_eq(append_import.url, base + "/blocks/page_123/children", "append import URL")
  expect_eq(len(append_import.body.children), 1, "append import children")
  let file_import = artifact_import_request(
    {
      mode: "external_file",
      filename: "report.pdf",
      external_url: "https://example.com/report.pdf",
      attach_to_page_id: "page_123",
    },
  )
  expect_eq(file_import.url, base + "/file_uploads", "file import create URL")
  expect_eq(file_import.body.mode, "external_url", "external file import mode")
  expect_eq(file_import.body.content_type, "application/pdf", "external file content type")
  expect_eq(len(file_import.steps), 2, "external file import attach steps")
  expect_eq(file_import.steps[1].id, "append_file_block", "external file attach step")
  let missing_auth = call("pages.retrieve", {page_id: "page_123", api_token: ""})
  expect(is_err(missing_auth), "empty api token rejects before dispatch")
  expect_eq(unwrap_err(missing_auth).code, "missing_api_token", "missing api token code")
  expect_eq(
    unwrap_err(missing_auth).auth_scope_failure.kind,
    "missing_auth",
    "missing api token recovery",
  )
  // F8: outbound calls to non-allowlisted hosts are rejected so the
  // workspace API token cannot reach attacker-controlled origins.
  let bad_host = call(
    "pages.retrieve",
    {page_id: "page_123", api_token: "secret_api", api_base_url: "https://evil.example/v1"},
  )
  expect(is_err(bad_host), "F8: disallowed api_base_url rejected")
  expect_eq(unwrap_err(bad_host).code, "disallowed_api_base_url", "F8: disallowed host code")
  let bad_url = call("pages.retrieve", {page_id: "page_123", api_token: "secret_api", api_base_url: "not-a-url"})
  expect(is_err(bad_url), "F8: malformed api_base_url rejected")
  expect_eq(unwrap_err(bad_url).code, "invalid_api_base_url", "F8: malformed url code")
  http_mock_clear()
  shutdown()
}
