import { call, init, shutdown } from "../src/lib"
import { expect, expect_eq } from "./assertions"

pipeline default() {
  shutdown()
  init(
    {api_token: "secret_api", api_base_url: "https://notion.test/v1", notion_version: "2026-03-11"},
  )
  http_mock_clear()
  let base = "https://notion.test/v1"
  http_mock(
    "*",
    base + "/*",
    {
      responses: [
        {
          status: 200,
          body: "{\"object\":\"page\",\"id\":\"page_123\"}",
          headers: {["x-request-id"]: "req_page"},
        },
        {
          status: 200,
          body: "{\"object\":\"list\",\"results\":[{\"id\":\"page_a\"}],\"has_more\":false}",
          headers: {},
        },
        {status: 200, body: "{\"object\":\"page\",\"id\":\"page_new\"}", headers: {}},
        {status: 200, body: "{\"object\":\"block\",\"id\":\"block_1\"}", headers: {}},
        {status: 200, body: "{\"object\":\"list\",\"results\":[],\"has_more\":false}", headers: {}},
        {status: 200, body: "{\"object\":\"comment\",\"id\":\"comment_1\"}", headers: {}},
      ],
    },
  )
  let page = call("pages.retrieve", {page_id: "page_123"})
  expect_eq(page.id, "page_123", "pages.retrieve response")
  let query = call("databases.query", {database_id: "db_123", page_size: 10})
  expect_eq(query.object, "list", "databases.query response")
  call("pages.create", {parent: {database_id: "db_123"}, properties: {Name: {title: []}}})
  call("blocks.children.append", {block_id: "page_123", children: []})
  call("search.query", {query: "task"})
  call("comments.create", {parent: {page_id: "page_123"}, rich_text: []})
  let calls = http_mock_calls()
  expect_eq(len(calls), 6, "all expected outbound methods dispatched")
  expect_eq(calls[0].method, "GET", "retrieve uses GET")
  expect_eq(calls[0].url, base + "/pages/page_123", "retrieve URL")
  expect_eq(calls[0].headers.get("authorization"), "[redacted]", "authorization header is redacted")
  expect_eq(calls[0].headers.get("notion-version"), "2026-03-11", "notion version header")
  expect_eq(calls[1].method, "POST", "query uses POST")
  expect_eq(calls[1].url, base + "/databases/db_123/query", "database query URL")
  let query_body = json_parse(calls[1].body)
  expect_eq(query_body.get("page_size"), 10, "query body page size")
  expect_eq(calls[3].url, base + "/blocks/page_123/children", "append children URL")
  http_mock_clear()
  http_mock(
    "GET",
    base + "/pages/missing",
    {
      status: 404,
      body: "{\"object\":\"error\",\"code\":\"object_not_found\",\"message\":\"missing page\"}",
      headers: {["x-request-id"]: "req_404"},
    },
  )
  let missing = call("pages.retrieve", {page_id: "missing"})
  expect(is_err(missing), "non-2xx response becomes Err")
  expect_eq(unwrap_err(missing).code, "object_not_found", "NotionError code")
  expect_eq(unwrap_err(missing).status, 404, "NotionError status")
  let unsupported = call("workspaces.retrieve", {workspace_id: "workspace_1"})
  expect(is_err(unsupported), "unsupported method rejected")
  expect_eq(unwrap_err(unsupported).code, "method_not_found", "unsupported method code")
  http_mock_clear()
  shutdown()
}
