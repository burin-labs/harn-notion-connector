import { activate, init, kinds, payload_schema, provider_id, shutdown } from "../src/lib"

/** Build a Notion HMAC signature header for fixture request bodies. */
pub fn notion_headers(secret, body) {
  return {["x-notion-signature"]: "sha256=" + hmac_sha256(secret, body)}
}

/** Build a signed raw inbound webhook envelope for normalize_inbound tests. */
pub fn signed_raw(secret, body, extra = nil) {
  return {
    verification_token: secret,
    body_text: body,
    headers: notion_headers(secret, body),
    received_at: "2026-04-19T12:40:00Z",
  }
    + extra ?? {}
}

/** Read a recorded webhook fixture body by basename. */
pub fn fixture_body(name) {
  return read_file(source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/** Build a signed raw inbound webhook envelope from a recorded fixture. */
pub fn fixture_raw(name, secret, extra = nil) {
  return signed_raw(secret, fixture_body(name), extra)
}

/** Assert the exported connector lifecycle/interface surface. */
pub fn assert_notion_interface() {
  shutdown()
  require provider_id() == "notion", "provider id"
  require kinds() == ["webhook", "poll"], "supported kinds"
  require payload_schema().harn_schema_name == "NotionEventPayload", "payload schema name"
  let initialized = init({verification_token: "test-secret", api_token: "secret_api"})
  require initialized.initialized, "init stores state"
  let activated = activate(
    [
      {
        id: "notion.webhook",
        kind: "webhook",
        path: "/hooks/notion",
        secrets: {verification_token: "test-secret"},
      },
      {
        id: "notion.poll",
        kind: "poll",
        poll: {resource: "data_source", data_source_id: "ds_123", high_water_mark: "last_edited_time"},
        api_token: "secret_api",
      },
    ],
  )
  require activated.bindings == 2, "activate counts bindings"
  require activated.webhook_bindings == 1, "activate counts webhook bindings"
  require activated.poll_bindings == 1, "activate counts poll bindings"
}
