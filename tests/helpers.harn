import { activate, init, kinds, payload_schema, provider_id, shutdown } from "../src/lib"

/** Build a Notion HMAC signature header for fixture request bodies. */
pub fn notion_headers(secret: any, body: any) {
  return {"x-notion-signature": "sha256=" + hmac_sha256(secret, body)}
}

/**
 * Rewrite a fixture body so its `timestamp` field falls inside the
 * connector's F6 freshness window (300s). Re-emits canonical JSON via
 * `json_stringify` so callers can sign over the refreshed bytes.
 */
pub fn refresh_body_timestamp(clock: HarnessClock, body: any) {
  const parsed = try {
    json_parse(body)
  }
  if is_err(parsed) {
    return body
  }
  const payload = unwrap(parsed)
  if type_of(payload) != "dict" {
    return body
  }
  const now_iso = date_format(clock.timestamp(), "%Y-%m-%dT%H:%M:%SZ")
  return json_stringify(payload + {timestamp: now_iso})
}

/** Build a signed raw inbound webhook envelope for normalize_inbound tests. */
pub fn signed_raw(clock: HarnessClock, secret: any, body: any, extra: any = nil) {
  const fresh = refresh_body_timestamp(clock, body)
  return {verification_token: secret, body_text: fresh, headers: notion_headers(secret, fresh)}
    + (extra
      ?? {})
}

/** Read a recorded webhook fixture body by basename. */
pub fn fixture_body(fs: HarnessFs, name: any) {
  return fs.read_text(fs.source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/**
 * Read a fixture body and rewrite its `timestamp` to the current clock so
 * the F6 freshness check accepts it. Use this in assertions that expect
 * the unmodified-fixture event payload (other than the timestamp field).
 */
pub fn fixture_body_fresh(harness: {clock: HarnessClock, fs: HarnessFs}, name: any) {
  return refresh_body_timestamp(harness.clock, fixture_body(harness.fs, name))
}

/** Build a signed raw inbound webhook envelope from a recorded fixture. */
pub fn fixture_raw(
  harness: {clock: HarnessClock, fs: HarnessFs},
  name: any,
  secret: any,
  extra: any = nil,
) {
  return signed_raw(harness.clock, secret, fixture_body(harness.fs, name), extra)
}

/** Assert the exported connector lifecycle/interface surface. */
pub fn assert_notion_interface(harness: Harness) {
  shutdown(harness)
  require provider_id() == "notion", "provider id"
  require kinds() == ["webhook", "poll"], "supported kinds"
  require payload_schema().harn_schema_name == "NotionEventPayload", "payload schema name"
  const initialized = init(harness, {verification_token: "test-secret", api_token: "secret_api"})
  require initialized.initialized, "init stores state"
  const activated = activate(
    harness,
    [
      {
        id: "notion.webhook",
        kind: "webhook",
        path: "/hooks/notion",
        secrets: {verification_token: "test-secret"},
      },
      {
        id: "notion.poll",
        kind: "poll",
        poll: {
          resource: "data_source",
          data_source_id: "ds_123",
          high_water_mark: "last_edited_time",
        },
        api_token: "secret_api",
      },
    ],
  )
  require activated.bindings == 2, "activate counts bindings"
  require activated.webhook_bindings == 1, "activate counts webhook bindings"
  require activated.poll_bindings == 1, "activate counts poll bindings"
}
