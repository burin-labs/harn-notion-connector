import { expect, expect_eq } from "../testdata/assertions"

/**
 * The manifest is the only place that says which of this connector's two
 * secrets authenticates an outgoing call and which verifies an incoming
 * webhook. Harn derives `harn connect status` usability from the outbound
 * set alone, so a regression to the legacy undirected form
 * (`required_secrets = ["notion/api-token", "notion/verification-token"]`)
 * silently reclassifies the verification token as outbound and makes an
 * outbound-only installation report unusable.
 *
 * That regression is invisible to every other test here: the connector's own
 * code never reads `required_secrets`. This test reads the manifest and
 * asserts the exact declared direction per secret, so the legacy form fails
 * rather than passing quietly.
 */
/**
 * The slice of `harn.toml` this test reads. Declared rather than assumed so a
 * manifest that loses `providers[].setup.required_secrets` entirely fails
 * here with a validation error instead of reading as an empty list.
 */
const MANIFEST_SHAPE = {
  type: "object",
  required: ["providers"],
  properties: {
    providers: {
      type: "array",
      items: {
        type: "object",
        required: ["setup"],
        properties: {
          setup: {
            type: "object",
            required: ["required_secrets", "health_checks"],
            properties: {required_secrets: {type: "array"}, health_checks: {type: "array"}},
          },
        },
      },
    },
  },
}

pipeline test_manifest_declares_secret_directions(harness: Harness) {
  const manifest = schema_expect(
    toml_parse(harness.fs.read_text(harness.fs.source_dir() + "/../harn.toml")),
    MANIFEST_SHAPE,
  )
  const providers = manifest.providers
  expect_eq(len(providers), 1, "manifest declares exactly one provider")
  const provider = providers[0]
  assert(provider != nil, "manifest declares at least one provider")
  const setup = provider.setup
  const required = setup.required_secrets
  expect_eq(len(required), 2, "notion declares exactly two required secrets")
  // Read by id rather than by list position: the direction is a property of
  // the secret, and an ordering change must not decide the assertion.
  let directions = {}
  for entry in required {
    expect(
      type_of(entry) == "dict",
      "required_secrets entry must be the typed { id, direction } form, not a bare string: "
        + to_string(entry),
    )
    directions[entry.id] = entry.direction
  }
  expect_eq(
    directions["notion/api-token"],
    "outbound",
    "the integration token authenticates outgoing Notion calls",
  )
  expect_eq(
    directions["notion/verification-token"],
    "inbound",
    "the verification token authenticates incoming signed webhooks",
  )
  // Every declared secret keeps a health check, so neither credential can be
  // migrated to a direction and quietly lose its readiness probe.
  let checked = {}
  for check in setup.health_checks {
    checked[check.secret] = true
  }
  expect(checked["notion/api-token"], "outbound credential keeps a health check")
  expect(checked["notion/verification-token"], "inbound credential keeps a health check")
}
