import { normalize_inbound, shutdown } from "../src/lib"
import { expect, expect_eq } from "./assertions"
import {
  assert_notion_interface,
  fixture_body,
  fixture_body_fresh,
  fixture_raw,
  notion_headers,
} from "./helpers"

pipeline test_normalize_smoke(harness: Harness) {
  const secret = "test-verification-token"
  assert_notion_interface(harness)
  const page = normalize_inbound(
    harness,
    fixture_raw({clock: harness.clock, fs: harness.fs}, "page_content_updated", secret),
  )
  expect_eq(page.type, "event", "page envelope type")
  expect_eq(page.event.kind, "page.content_updated", "page event kind")
  expect_eq(page.event.signature_status.state, "verified", "page signed")
  expect_eq(page.event.payload.event_type, "page.content_updated", "page event type")
  expect_eq(page.event.payload.provider, "notion", "page provider payload provider")
  expect_eq(page.event.payload.event, "page.content_updated", "page provider payload event")
  expect_eq(page.event.payload.workspace_id, "ws_test", "page workspace id")
  expect_eq(page.event.payload.subscription_id, "sub_test", "page subscription id")
  expect_eq(page.event.payload.integration_id, "int_test", "page integration id")
  expect_eq(page.event.payload.entity_id, "page_alpha", "page entity id")
  expect_eq(page.event.payload.entity_type, "page", "page entity type")
  expect_eq(page.event.payload.resource_id, "page_alpha", "page resource id")
  expect_eq(page.event.payload.parent_id, "database_tasks", "page parent id")
  expect_eq(page.event.payload.actor.id, "user_ada", "page actor id")
  // F6: timestamp is now refreshed at fixture-load to stay inside the
  // 300s replay window; assert the field is populated rather than pinning
  // the exact value.
  expect(page.event.payload.occurred_at != nil, "page occurred_at populated")
  expect(page.event.dedupe_key != "" && page.event.dedupe_key != nil, "page dedupe key populated")
  const fresh_body = fixture_body_fresh(
    {clock: harness.clock, fs: harness.fs},
    "page_content_updated",
  )
  const raw_body = normalize_inbound(
    harness,
    {
      verification_token: secret,
      raw_body: bytes_from_string(fresh_body),
      headers: notion_headers(secret, fresh_body),
    },
  )
  expect_eq(raw_body.type, "event", "raw_body envelope type")
  expect_eq(raw_body.event.kind, "page.content_updated", "raw_body event kind")
  const database = normalize_inbound(
    harness,
    fixture_raw({clock: harness.clock, fs: harness.fs}, "database_created", secret),
  )
  expect_eq(database.event.kind, "database.created", "database event kind")
  expect_eq(database.event.payload.event, "database.created", "database provider payload event")
  expect_eq(database.event.payload.entity_id, "database_projects", "database entity id")
  expect_eq(database.event.payload.entity_type, "database", "database entity type")
  expect_eq(database.event.payload.resource_id, "database_projects", "database resource id")
  expect_eq(database.event.payload.parent_id, "page_home", "database parent id")
  const comment = normalize_inbound(
    harness,
    fixture_raw({clock: harness.clock, fs: harness.fs}, "comment_created", secret),
  )
  expect_eq(comment.event.kind, "comment.created", "comment event kind")
  expect_eq(comment.event.payload.event, "comment.created", "comment provider payload event")
  expect_eq(comment.event.payload.entity_id, "comment_delta", "comment entity id")
  expect_eq(comment.event.payload.entity_type, "comment", "comment entity type")
  expect_eq(comment.event.payload.resource_id, "comment_delta", "comment resource id")
  expect_eq(comment.event.payload.parent_id, "page_alpha", "comment parent id")
  const event_body = fixture_body(harness.fs, "page_content_updated")
  const tampered = normalize_inbound(
    harness,
    {
      verification_token: secret,
      body_text: event_body + " ",
      headers: notion_headers(secret, event_body),
    },
  )
  expect_eq(tampered.type, "reject", "tampered body rejects")
  expect_eq(tampered.reject.status, 401, "tampered body status")
  const unsigned_non_verification = normalize_inbound(
    harness,
    {
      body_text: json_stringify(
        {
          id: "evt_unsigned",
          type: "page.content_updated",
          verification_token: "token-from-payload",
          entity: {id: "page_unsigned", type: "page"},
        },
      ),
      headers: {},
    },
  )
  expect_eq(
    unsigned_non_verification.type,
    "reject",
    "non-verification payloads still require signatures",
  )
  const missing_signature = normalize_inbound(
    harness,
    {verification_token: secret, body_text: event_body, headers: {}},
  )
  expect_eq(missing_signature.type, "reject", "missing signature rejects")
  const wrong_length = normalize_inbound(
    harness,
    {
      verification_token: secret,
      body_text: event_body,
      headers: {"x-notion-signature": "sha256=abc"},
    },
  )
  expect_eq(wrong_length.type, "reject", "wrong length signature rejects")
  const wrong_secret = normalize_inbound(
    harness,
    {
      verification_token: "wrong-secret",
      body_text: event_body,
      headers: notion_headers(secret, event_body),
    },
  )
  expect_eq(wrong_secret.type, "reject", "wrong secret rejects")
  shutdown(harness)
  const missing_secret = normalize_inbound(
    harness,
    {body_text: event_body, headers: notion_headers(secret, event_body)},
  )
  expect_eq(missing_secret.type, "reject", "missing secret rejects")
  const source = harness.fs.read_text(harness.fs.source_dir() + "/../src/lib.harn")
  expect(
    source.contains("constant_time_eq(expected, provided)"),
    "signature comparison uses constant_time_eq",
  )
  // F5: subscription.verification handshake now emits under a dedicated
  // kind so downstream code can opt into the unsigned path explicitly;
  // generic signed events must NOT carry verification_token through.
  const verification_body = json_stringify(
    {verification_token: "verify-token", type: "subscription.verification", id: "verification_1"},
  )
  const verification = normalize_inbound(harness, {body_text: verification_body, headers: {}})
  expect_eq(verification.type, "event", "F5: verification emits an event")
  expect_eq(
    verification.event.kind,
    "notion.subscription.verification",
    "F5: verification uses dedicated kind",
  )
  expect_eq(verification.event.signature_status.state, "unsigned", "F5: verification is unsigned")
  expect_eq(
    verification.event.payload.verification_token,
    "verify-token",
    "F5: verification_token surfaces on the dedicated kind",
  )
  // F5: cap on verification_token length.
  let oversized = ""
  let i = 0
  while i < 600 {
    oversized = oversized + "a"
    i = i + 1
  }
  const oversized_body = json_stringify(
    {verification_token: oversized, type: "subscription.verification", id: "verification_long"},
  )
  const oversized_result = normalize_inbound(harness, {body_text: oversized_body, headers: {}})
  expect_eq(oversized_result.type, "reject", "F5: oversized verification_token rejects")
  // F5: generic signed events must NOT carry verification_token through.
  const fresh = fixture_body_fresh({clock: harness.clock, fs: harness.fs}, "page_content_updated")
  const signed_with_token_body = json_stringify(
    json_parse(fresh) + {verification_token: "should-not-surface"},
  )
  const signed_with_token = normalize_inbound(
    harness,
    {
      verification_token: secret,
      body_text: signed_with_token_body,
      headers: notion_headers(secret, signed_with_token_body),
    },
  )
  expect_eq(signed_with_token.type, "event", "F5: signed event still accepted")
  expect_eq(
    signed_with_token.event.payload.verification_token,
    nil,
    "F5: verification_token stripped from generic signed payloads",
  )
  // F6: stale signed-body timestamps fall outside the 300s replay window.
  const stale_body = json_stringify(
    {
      id: "evt_stale",
      timestamp: "2024-01-01T00:00:00Z",
      type: "page.content_updated",
      entity: {id: "page_stale", type: "page"},
    },
  )
  const stale = normalize_inbound(
    harness,
    {
      verification_token: secret,
      body_text: stale_body,
      headers: notion_headers(secret, stale_body),
    },
  )
  expect_eq(stale.type, "reject", "F6: stale payload.timestamp rejects")
  shutdown(harness)
}
