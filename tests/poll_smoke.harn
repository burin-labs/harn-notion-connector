import { init, poll_tick, shutdown } from "../src/lib"
import { expect, expect_eq } from "../testdata/assertions"

fn poll_ctx(cursor: any = nil, state: any = nil, extra: any = nil) {
  return {
    provider_id: "notion",
    binding_id: "notion.poll",
    tick_at: "2026-04-19T11:00:00Z",
    cursor: cursor,
    state: state,
    state_key: "notion:ds_123",
    lease: {id: "lease-test", tenant_id: "tenant-test"},
    max_batch_size: 10,
    binding: {
      id: "notion.poll",
      kind: "poll",
      config: {
        poll: {
          resource: "data_source",
          data_source_id: "ds_123",
          page_size: 2,
          high_water_mark: "last_edited_time",
          state_key: "notion:ds_123",
        },
        api_token: "secret_api",
      },
    },
  }
    + (extra ?? {})
}

fn page(id: any, edited_at: any, parent_id: any = "ds_123") {
  return {
    object: "page",
    id: id,
    last_edited_time: edited_at,
    last_edited_by: {object: "user", id: "user_ada", name: "Ada"},
    parent: {database_id: parent_id},
  }
}

fn list_body(results: any, has_more: any = false, next_cursor: any = nil) {
  return json_stringify(
    {object: "list", results: results, has_more: has_more, next_cursor: next_cursor},
  )
}

pipeline test_poll_smoke(harness: Harness) {
  harness.net.egress_policy({allow: ["api.notion.com"], default: "deny"})
  shutdown(harness)
  init(harness, {api_base_url: "https://api.notion.com/v1", notion_version: "2026-03-11"})
  harness.testing.http_mock_clear()
  const base = "https://api.notion.com/v1"
  harness.testing.http_mock(
    "POST",
    base + "/data_sources/ds_123/query",
    {
      responses: [
        {status: 200, body: list_body([page("page_1", "2026-04-19T10:00:00Z")]), headers: {}},
        {status: 200, body: list_body([page("page_2", "2026-04-19T10:05:00Z")]), headers: {}},
        {
          status: 503,
          body: "{\"object\":\"error\",\"code\":\"service_unavailable\",\"message\":\"try again\"}",
          headers: {},
        },
        {status: 200, body: list_body([page("page_3", "2026-04-19T10:10:00Z")]), headers: {}},
      ],
    },
  )
  const first = poll_tick(harness, poll_ctx())
  expect_eq(len(first.events), 1, "first tick emits one normalized event")
  expect_eq(first.events[0].kind, "page.content_updated", "poll event kind")
  expect_eq(first.events[0].payload.event_type, "page.content_updated", "payload event type")
  expect_eq(first.events[0].payload.resource_id, "page_1", "poll resource id")
  expect_eq(first.events[0].payload.parent_id, "ds_123", "poll parent id")
  expect_eq(first.events[0].payload.actor.id, "user_ada", "poll actor id")
  expect_eq(first.events[0].occurred_at, "2026-04-19T10:00:00Z", "poll occurred_at")
  expect_eq(
    first.events[0].dedupe_key,
    "notion:page.content_updated:page_1:2026-04-19T10:00:00Z",
    "poll dedupe key matches normalized event identity",
  )
  expect_eq(first.cursor.last_edited_time, "2026-04-19T10:00:00Z", "first tick advances cursor")
  expect(
    first.state.poll_cache.get("notion.poll:page_1") != nil,
    "first tick persists page snapshot",
  )
  const second = poll_tick(harness, poll_ctx(first.cursor, first.state))
  expect_eq(len(second.events), 1, "second tick emits only changed/new pages")
  expect_eq(second.events[0].payload.resource_id, "page_2", "second tick new page id")
  expect_eq(second.cursor.last_edited_time, "2026-04-19T10:05:00Z", "second tick advances cursor")
  const failed = poll_tick(harness, poll_ctx(second.cursor, second.state))
  expect(is_err(failed), "retryable Notion failures return Err without advancing local state")
  expect_eq(unwrap_err(failed).code, "service_unavailable", "retry error preserves Notion code")
  const retried = poll_tick(harness, poll_ctx(second.cursor, second.state))
  expect_eq(len(retried.events), 1, "retry with same cursor can emit after transient failure")
  expect_eq(retried.events[0].payload.resource_id, "page_3", "retry emits next page")
  const calls = harness.testing.http_mock_calls()
  expect_eq(len(calls), 4, "one Notion query per tick")
  const first_query_body = json_parse(calls[0].body)
  expect_eq(first_query_body.get("filter"), nil, "first tick has no high-water filter")
  const second_query_body = json_parse(calls[1].body)
  expect_eq(
    second_query_body.get("filter").last_edited_time.after,
    "2026-04-19T10:00:00Z",
    "second tick uses Harn-managed cursor",
  )
  const retried_query_body = json_parse(calls[3].body)
  expect_eq(
    retried_query_body.get("filter").last_edited_time.after,
    "2026-04-19T10:05:00Z",
    "retry uses unchanged cursor from failed tick",
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    base + "/data_sources/ds_123/query",
    {status: 200, body: list_body([page("page_1", "2026-04-19T10:00:00Z")]), headers: {}},
  )
  const duplicate = poll_tick(harness, poll_ctx(nil, first.state))
  expect_eq(len(duplicate.events), 0, "persisted state dedupes identical page snapshots")
  expect_eq(
    duplicate.cursor.last_edited_time,
    "2026-04-19T10:00:00Z",
    "duplicate-only tick can safely advance cursor",
  )
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    base + "/data_sources/ds_123/query",
    {
      responses: [
        {
          status: 200,
          body: list_body(
            [page("page_a", "2026-04-19T10:20:00Z"), page("page_b", "2026-04-19T10:25:00Z")],
          ),
          headers: {},
        },
        {
          status: 200,
          body: list_body(
            [page("page_a", "2026-04-19T10:20:00Z"), page("page_b", "2026-04-19T10:25:00Z")],
          ),
          headers: {},
        },
      ],
    },
  )
  const capped = poll_tick(harness, poll_ctx(nil, nil, {max_batch_size: 1}))
  expect_eq(len(capped.events), 1, "max_batch_size caps emitted events")
  expect_eq(capped.events[0].payload.resource_id, "page_a", "capped tick emits first event")
  expect_eq(capped.cursor, nil, "capped tick leaves cursor unchanged for retry-safe draining")
  const drained = poll_tick(harness, poll_ctx(capped.cursor, capped.state, {max_batch_size: 1}))
  expect_eq(len(drained.events), 1, "next capped tick drains the next uncached event")
  expect_eq(drained.events[0].payload.resource_id, "page_b", "drained tick emits second event")
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    base + "/data_sources/ds_123/query",
    {
      responses: [
        {
          status: 200,
          body: list_body([page("page_page_1", "2026-04-19T10:30:00Z")], true, "cursor-next"),
          headers: {},
        },
        {status: 200, body: list_body([page("page_page_2", "2026-04-19T10:35:00Z")]), headers: {}},
      ],
    },
  )
  const first_page_only = poll_tick(harness, poll_ctx(nil, nil))
  expect_eq(len(first_page_only.events), 1, "poll tick emits the first query page")
  expect_eq(first_page_only.events[0].payload.resource_id, "page_page_1", "first query page event")
  expect_eq(
    len(harness.testing.http_mock_calls()),
    1,
    "poll tick does not chase provider pagination in one tick",
  )
  harness.testing.http_mock_clear()
  shutdown(harness)
}
