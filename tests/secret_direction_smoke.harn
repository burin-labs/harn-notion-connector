import "std/schema"
import { call, init, normalize_inbound, shutdown } from "../src/lib"
import { expect, expect_eq } from "./assertions"
import { fixture_body_fresh, notion_headers } from "./helpers"

type RequiredSecretProjection = {id: string, direction: string}

type SetupProjection = {required_secrets: list<RequiredSecretProjection>}

type ProviderProjection = {setup: SetupProjection}

type ManifestProjection = {providers: list<ProviderProjection>}

fn required_secret_schema() -> Schema<RequiredSecretProjection> {
  return schema_refine(
    schema_of(RequiredSecretProjection),
    schema_object(
      {id: schema_field(schema_string()), direction: schema_field(schema_string())},
      {additional_properties: true},
    ),
  )
}

fn setup_schema() -> Schema<SetupProjection> {
  return schema_refine(
    schema_of(SetupProjection),
    schema_object(
      {required_secrets: schema_field(schema_list(required_secret_schema()))},
      {additional_properties: true},
    ),
  )
}

fn provider_schema() -> Schema<ProviderProjection> {
  return schema_refine(
    schema_of(ProviderProjection),
    schema_object({setup: schema_field(setup_schema())}, {additional_properties: true}),
  )
}

fn manifest_schema() -> Schema<ManifestProjection> {
  return schema_refine(
    schema_of(ManifestProjection),
    schema_object(
      {providers: schema_field(schema_list(provider_schema()))},
      {additional_properties: true},
    ),
  )
}

fn outbound_page(harness: Harness, token: any) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.notion.com/v1/pages/page_123",
    {status: 200, body: "{\"object\":\"page\",\"id\":\"page_123\"}", headers: {}},
  )
  return call(harness, "pages.retrieve", {page_id: "page_123", api_token: token})
}

fn outbound_data_source(harness: Harness, token: any) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    "https://api.notion.com/v1/data_sources/data_source_123/query",
    {status: 200, body: "{\"object\":\"list\",\"results\":[]}", headers: {}},
  )
  return call(harness, "data_sources.query", {data_source_id: "data_source_123", api_token: token})
}

fn signed_webhook(harness: Harness, token: any) {
  const body = fixture_body_fresh({clock: harness.clock, fs: harness.fs}, "page_content_updated")
  let raw = {body_text: body, headers: notion_headers("fixture-inbound", body)}
  if token != nil {
    raw.verification_token = token
  }
  return normalize_inbound(harness, raw)
}

pipeline test_secret_directions(harness: Harness) {
  harness.net.egress_policy({allow: ["api.notion.com"], default: "deny"})
  const manifest: ManifestProjection = schema_expect(
    toml_parse(harness.fs.read_text(harness.fs.source_dir() + "/../harn.toml")),
    manifest_schema(),
  )
  expect_eq(len(manifest.providers), 1, "manifest declares the Notion provider")
  const provider = manifest.providers.first ?? {setup: {required_secrets: []}}
  const secrets = provider.setup.required_secrets
  expect_eq(len(secrets), 2, "manifest declares both credential directions")
  expect_eq(secrets[0].id, "notion/api-token", "outbound secret id")
  expect_eq(secrets[0].direction, "outbound", "API token direction")
  expect_eq(secrets[1].id, "notion/verification-token", "inbound secret id")
  expect_eq(secrets[1].direction, "inbound", "verification token direction")
  // Neither credential: neither protected interface is usable.
  shutdown(harness)
  const neither_outbound = outbound_page(harness, "")
  expect(is_err(neither_outbound), "neither: outbound call rejects")
  expect_eq(unwrap_err(neither_outbound).code, "missing_api_token", "neither: outbound reason")
  expect_eq(signed_webhook(harness, nil).type, "reject", "neither: webhook rejects")
  // Outbound only: page and data-source operations work, while webhook
  // verification remains independently unavailable.
  shutdown(harness)
  init(harness, {api_token: "fixture-outbound"})
  expect_eq(outbound_page(harness, "fixture-outbound").id, "page_123", "outbound-only page")
  expect_eq(
    outbound_data_source(harness, "fixture-outbound").object,
    "list",
    "outbound-only data source",
  )
  expect_eq(signed_webhook(harness, nil).type, "reject", "outbound-only webhook rejects")
  // Inbound only: signed webhooks work, while outbound calls remain unavailable.
  shutdown(harness)
  init(harness, {verification_token: "fixture-inbound"})
  const inbound_only = signed_webhook(harness, nil)
  expect_eq(inbound_only.type, "event", "inbound-only webhook accepts")
  expect_eq(inbound_only.event.signature_status.state, "verified", "inbound-only verified")
  const inbound_only_outbound = outbound_page(harness, "")
  expect(is_err(inbound_only_outbound), "inbound-only outbound call rejects")
  expect_eq(
    unwrap_err(inbound_only_outbound).code,
    "missing_api_token",
    "inbound-only outbound reason",
  )
  // Both credentials: both protected interfaces are usable.
  shutdown(harness)
  init(harness, {api_token: "fixture-outbound", verification_token: "fixture-inbound"})
  expect_eq(outbound_page(harness, "fixture-outbound").id, "page_123", "both: outbound page")
  expect_eq(signed_webhook(harness, nil).type, "event", "both: webhook accepts")
  harness.testing.http_mock_clear()
  shutdown(harness)
}
